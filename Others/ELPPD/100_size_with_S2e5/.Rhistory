sd(results$elppd_b_psis),
sd(results$elppd_z_is),
sd(results$elppd_z_tis),
sd(results$elppd_z_psis))
}
all.se.estimator <- c()
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
all.se.estimator <- c(all.se.estimator, extract_se_estimator(results))
}
min_val_se <- min(all.se.estimator[all.se.estimator > 0], na.rm = TRUE)
max_val_se <- max(all.se.estimator, na.rm = TRUE)
common.se.ylim <- c(min_val_se * 0.8, max_val_se * 1.2)
pdf("se.pdf", width = pdf_width, height = pdf_height)
par(mfrow = c(rows, cols),
mar = c(6, 4, 3, 1),
mgp = c(2, 0.7, 0),
tcl = -0.3)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
plot_se_panel(results = results,
title = paste0("K = ", K),
ylim = common.se.ylim)
}
dev.off()
# 3. Asymptotic Variance comparison plot
plot_var_panel_asymp <- function(results,
title,
S_mcmc = 5e5,
ylim = NULL){
# Scale estimated variances by S_mcmc to put them on the asymptotic scale (sigma2_ELPPD)
plot.data <- list(
S_mcmc * results$var_g_is,
S_mcmc * results$var_g_tis,
S_mcmc * results$var_g_psis,
S_mcmc * results$var_b_is,
S_mcmc * results$var_b_tis,
S_mcmc * results$var_b_psis,
S_mcmc * results$var_z_is,
S_mcmc * results$var_z_tis,
S_mcmc * results$var_z_psis
)
# Sample variances on asymptotic scale
samp.var <- S_mcmc * c(
var(results$elppd_g_is),
var(results$elppd_g_tis),
var(results$elppd_g_psis),
var(results$elppd_b_is),
var(results$elppd_b_tis),
var(results$elppd_b_psis),
var(results$elppd_z_is),
var(results$elppd_z_tis),
var(results$elppd_z_psis)
)
pos <- 1:9
boxplot(plot.data,
col = box.cols,
border = "black",
las = 2,
outline = FALSE,
xaxt = "n",
ylim = ylim,
log = "y",
ylab = expression(S %*% Variance ~ (log - scale)),
xlab = "Method",
main = title)
axis(1,
at = 1:9,
labels = rep(c("IS", "TIS", "PSIS"), 3),
las = 2)
axis(1,
at = c(2, 5, 8),
labels = c("Gelfand", "Bronze", "Zanella"),
tick = FALSE,
line = 3)
# Sample variance benchmark
segments(pos - 0.25,
samp.var,
pos + 0.25,
samp.var,
lwd = 2,
col = "red")
legend("topright",
legend = c("IS asymp.var",
"TIS asymp.var",
"PSIS asymp.var",
"Sample var * S"),
fill = c(box.cols[c(1,2,3)], NA),
border = c("black", "black", "black", NA),
lty = c(NA, NA, NA, 1),
lwd = c(NA, NA, NA, 2),
col = c(NA, NA, NA, "red"),
bty = "n",
cex = 0.9)
}
