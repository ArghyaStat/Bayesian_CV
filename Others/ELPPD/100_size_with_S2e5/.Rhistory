las = 2)
axis(1,
at = c(2, 5, 8),
labels = c("Gelfand", "Bronze", "Zanella"),
tick = FALSE,
line = 3)
# Sample standard deviation benchmark
segments(pos - 0.25,
samp.se,
pos + 0.25,
samp.se,
lwd = 2,
col = "red")
legend("topright",
legend = c("IS est.se",
"TIS est.se",
"PSIS est.se",
"Sample SD"),
fill = c(submethod.cols, NA),
border = c("black", "black", "black", NA),
lty = c(NA, NA, NA, 1),
lwd = c(NA, NA, NA, 2),
col = c(NA, NA, NA, "red"),
bty = "n",
cex = 0.9)
}
