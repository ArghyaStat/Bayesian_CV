rm(list = ls())
mydir <- this.path::here()
setwd(mydir)
# User inputs
n <- 1e2
d <- 1e1
sigma2 <- 1
tau2 <- 1e2
set.seed(1709)
# Simulate Gaussian linear model
sim_data <- function(n, d){
X <- matrix(rnorm(n*d), n, d)
beta_true <- rnorm(d)
y <- X %*% beta_true + rnorm(n, sd = sqrt(sigma2))
list(X = X,
y = as.vector(y),
beta_true = beta_true)
}
dat <- sim_data(n, d)
X <- dat$X
y <- dat$y
# Exact tractable LOO-ELPPD
exact_elpd_gaussian <- function(
X,
y,
sigma2,
tau2){
n <- nrow(X)
d <- ncol(X)
log_ppds <- numeric(n)
for(i in 1:n){
# Leave-one-out data
X_loo <- X[-i, , drop = FALSE]
y_loo <- y[-i]
x_test <- matrix(X[i, ], nrow = 1)
y_test <- y[i]
# Exact Gaussian posterior of beta | y_-i
V_post <- solve(crossprod(X_loo) / sigma2 + diag(1 / tau2, d))
m_post <- V_post %*% crossprod(X_loo, y_loo) / sigma2
# Exact posterior predictive mean and variance
pred_mean <- as.numeric(x_test %*% m_post)
pred_var <- as.numeric(sigma2 + x_test %*% V_post %*% t(x_test))
# Exact log ppd
log_ppds[i] <- dnorm(x = y_test,
mean = pred_mean,
sd = sqrt(pred_var),
log = TRUE)
}
sum(log_ppds)
}
# Exact ELPPD
elppd_exact <- exact_elpd_gaussian(X = X,
y = y,
sigma2 = sigma2,
tau2 = tau2)
elppd_exact
# Fold settings
K.vec <- c(10, 20, 50, 100)
# Colors
submethod.cols <- c("steelblue",   # IS
"darkorange",  # TIS
"forestgreen"  # PSIS
)
box.cols <- rep(submethod.cols, 3)
# Adaptive approach for par(mfrow)
num_plots <- length(K.vec)
rows <- floor(sqrt(num_plots))
cols <- ceiling(num_plots / rows)
# Adaptive width and height
pdf_width <- 5 * cols
pdf_height <- 4.5 * rows
# 1. ELPPD comparison plot
plot_elpd_panel <- function(results,
true_elpd,
title,
ylim = NULL){
plot.data <- list(
results$elppd_g_is,
results$elppd_g_tis,
results$elppd_g_psis,
results$elppd_b_is,
results$elppd_b_tis,
results$elppd_b_psis,
results$elppd_z_is,
results$elppd_z_tis,
results$elppd_z_psis
)
boxplot(plot.data,
col = box.cols,
border = "black",
las = 2,
outline = FALSE,
xaxt = "n",
ylim = ylim,
ylab = "ELPPD",
xlab = "Method",
main = title)
axis(1,
at = 1:9,
labels = rep(c("IS", "TIS", "PSIS"), 3),
las = 2)
axis(1,
at = c(2, 5, 8),
labels = c("Gelfand", "Bronze", "Zanella"),
tick = FALSE,
line = 3)
abline(h = true_elpd,
col = "red",
lwd = 2,
lty = 2)
legend("bottomright",
legend = c("IS", "TIS", "PSIS", "Gold ELPPD"),
fill = c(submethod.cols, NA),
border = c("black", "black", "black", NA),
lty = c(NA, NA, NA, 2),
lwd = c(NA, NA, NA, 2),
col = c(NA, NA, NA, "red"),
bty = "n",
cex = 0.9)
}
extract_elppd <- function(results){
c(results$elppd_g_is,
results$elppd_g_tis,
results$elppd_g_psis,
results$elppd_b_is,
results$elppd_b_tis,
results$elppd_b_psis,
results$elppd_z_is,
results$elppd_z_tis,
results$elppd_z_psis)
}
all.elppd <- c()
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
all.elppd <- c(all.elppd, extract_elppd(results), elppd_exact)
}
common.elppd.ylim <- range(all.elppd, na.rm = TRUE)
pdf("elppd.pdf", width = pdf_width, height = pdf_height)
par(mfrow = c(rows, cols),
mar = c(6, 4, 3, 1),
mgp = c(2, 0.7, 0),
tcl = -0.3)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
plot_elpd_panel(results = results,
true_elpd = elppd_exact,
title = paste0("K = ", K),
ylim = common.elppd.ylim)
}
dev.off()
# 2. Standard Errors comparison plot
plot_se_panel <- function(results,
title,
ylim = NULL){
plot.data <- list(
sqrt(results$var_g_is),
sqrt(results$var_g_tis),
sqrt(results$var_g_psis),
sqrt(results$var_b_is),
sqrt(results$var_b_tis),
sqrt(results$var_b_psis),
sqrt(results$var_z_is),
sqrt(results$var_z_tis),
sqrt(results$var_z_psis)
)
# Sample standard deviations of the estimators
samp.se <- c(
sd(results$elppd_g_is),
sd(results$elppd_g_tis),
sd(results$elppd_g_psis),
sd(results$elppd_b_is),
sd(results$elppd_b_tis),
sd(results$elppd_b_psis),
sd(results$elppd_z_is),
sd(results$elppd_z_tis),
sd(results$elppd_z_psis)
)
