> # User inputs
> tau2 <- 1e2
> 
> # Load simulated data (generated by logistic_simulation.R)
> load("logistic_data.RData")
> n <- nrow(X)
> d <- ncol(X)
> 
> # Bernoulli likelihood with logistic link
> log_like <- function(theta, X, y){
+   eta <- as.vector(X %*% theta)
+   loss <- pmax(eta, 0) + log1p(exp(-abs(eta)))
+   y * eta - loss
+ }
> 
> # Gradient log-likelihood
> grad_log_like <- function(theta, X, y){
+   eta <- as.vector(X %*% theta)
+   p <- plogis(eta)
+   X * as.vector(y - p)
+ }
> 
> # Gaussian prior
> log_prior <- function(theta){
+   sum(dnorm(theta, mean = 0, sd = sqrt(tau2), log = TRUE))
+ }
> 
> # Gradient prior
> grad_log_prior <- function(theta){
+   -theta / tau2
+ }
> 
> # Define exact_logistic_elppd function to compute the exact LOO-ELPPD in parallel
> exact_logistic_elppd <- function(X, y, tau2, S = 2e4, n.cores = 50) {
+   library(foreach)
+   library(doParallel)
+   
+   n <- nrow(X)
+   d <- ncol(X)
+   
+   cl <- makeCluster(n.cores)
+   registerDoParallel(cl)
+   
+   # Export global functions and samplers from GlobalEnv
+   clusterExport(cl, c("log_like", "grad_log_like", "log_prior", "grad_log_prior", 
+                       "leapfrog_hmc", "U_g", "grad_g", "log_q_g", "grad_log_q_g"))
+   
+   # Export function arguments from local environment
+   clusterExport(cl, c("X", "y", "tau2", "S"), envir = environment())
+   
+   log_ppds <- foreach(i = 1:n, .combine = c, .packages = c("MASS")) %dopar% {
+     
+     # Simple self-contained log_sum_exp helper
+     log_sum_exp_local <- function(x) {
+       m <- max(x)
+       m + log(sum(exp(x - m)))
+     }
+     
+     # Leave-one-out data
+     X_loo <- X[-i, , drop = FALSE]
+     y_loo <- y[-i]
+     
+     x_test <- matrix(X[i, ], nrow = 1)
+     y_test <- y[i]
+     
+     # Initialize from GLM fit on LOO data
+     theta_init <- glm(y_loo ~ X_loo - 1, family = binomial)$coef
+     
+     # Fit posterior of beta | y_-i
+     fit <- leapfrog_hmc(
+       epsilon = 0.35,
+       L = 10,
+       niters = S,
+       U = U_g,
+       grad_U = grad_g,
+       x_init = theta_init,
+       X = X_loo,
+       y = y_loo,
+       log_like = log_like,
+       log_prior = log_prior,
+       grad_log_like = grad_log_like,
+       grad_log_prior = grad_log_prior
+     )
+     
+     samples <- fit$samples
+     
+     # Evaluate log predictive density for observation i (no burn-in)
+     log_likes_test <- sapply(1:S, function(s) {
+       log_like(samples[s, ], x_test, y_test)
+     })
+     
+     # Stable log-mean-exp
+     log_ppds_i <- log_sum_exp_local(log_likes_test) - log(S)
+     log_ppds_i
+   }
+   
+   stopCluster(cl)
+   sum(log_ppds)
+ }
> 
> # Compute exact ELPPD using MCMC
> n.cores.sim <- min(parallel::detectCores() - 1, 50)
> cat("Computing exact LOO-ELPPD in parallel using", n.cores.sim, "cores...\n")
