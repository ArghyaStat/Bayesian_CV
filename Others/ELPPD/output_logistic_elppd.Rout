> # 1. ELPPD comparison plot
> 
> 
> plot_elpd_panel <- function(results,
+                             true_elpd,
+                             title,
+                             ylim = NULL){
+   
+   plot.data <- list(
+     results$elppd_g_is,
+     results$elppd_g_tis,
+     results$elppd_g_psis,
+     
+     results$elppd_b_is,
+     results$elppd_b_tis,
+     results$elppd_b_psis,
+     
+     results$elppd_z_is,
+     results$elppd_z_tis,
+     results$elppd_z_psis
+   )
+   
+   boxplot(plot.data,
+           col = box.cols,
+           border = "black",
+           las = 2,
+           outline = FALSE,
+           xaxt = "n",
+           ylim = ylim,
+           ylab = "ELPPD",
+           main = title)
+   
+   axis(1,
+        at = 1:9,
+        labels = rep(c("IS", "TIS", "PSIS"), 3),
+        las = 2)
+   
+   axis(1,
+        at = c(2, 5, 8),
+        labels = c("Gelfand", "Bronze", "Zanella"),
+        tick = FALSE,
+        line = 3)
+   
+   abline(h = true_elpd,
+          col = "red",
+          lwd = 2,
+          lty = 2)
+   
+   legend("bottomright",
+          legend = c("IS", "TIS", "PSIS", "Gold ELPPD"),
+          fill = c(submethod.cols, NA),
+          border = c("black", "black", "black", NA),
+          lty = c(NA, NA, NA, 2),
+          lwd = c(NA, NA, NA, 2),
+          col = c(NA, NA, NA, "red"),
+          bty = "n",
+          cex = 0.9)
+ }
> 
