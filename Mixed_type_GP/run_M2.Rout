> # Model M2 (Separate Covariance): K-fold ELJPD via Gibbs sampling from q_mix
> 
> rm(list = ls())
> invisible(gc())
> set.seed(35)
> 
> libraries <- c("fields", "FNN", "mcmcse", "coda", "sp", "gstat", "this.path",
+                "Rcpp", "RcppArmadillo")
> invisible(lapply(libraries, library, character.only = TRUE))
