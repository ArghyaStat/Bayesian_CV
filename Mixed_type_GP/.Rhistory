expression(italic(M)[2] ~ "(Separate Covariance GP)"),
sep_txt
),
col    = c(COL_M1, COL_M2, COL_SEP),
pch    = c(19, 1, NA),
lty    = c(1, 1, 4),
lwd    = c(3.2, 3.2, 3.2),
pt.cex = c(1.7, 1.7, NA),
pt.lwd = c(NA, 2.2, NA),
bty    = "o", bg = adjustcolor("white", 0.94), box.col = COL_BOX,
cex    = legend_cex, y.intersp = 1.15)
box(lwd = 1.8)
}
# Panel (b): Relative Efficiency (ESS / S) Plot
render_panel_b <- function(legend_cex = 1.25) {
plot(NA, xlim = xlim_common, ylim = ylim_ratio,
xlab = expression("Iterations (" * italic(S) * ")"),
ylab = "",
main = "", xaxt = "n", yaxt = "n")
title(ylab = expression(widehat(ESS)(italic(S)) / italic(S)), line = 4.8)
axis(1, at = s_ticks, labels = s_labels, gap.axis = 0)
axis(2, at = y_ticks_ratio, labels = y_labels_ratio)
abline(h = y_ticks_ratio, col = COL_GRID, lty = 1, lwd = 0.8)
abline(v = s_ticks,       col = COL_GRID, lty = 1, lwd = 0.8)
# Vertical separation boundary
if (!is.na(sep_S)) {
abline(v = sep_S, col = COL_SEP, lty = 4, lwd = 3.2)
}
# Reference line at ratio = 1.0 (Full Monte Carlo Efficiency)
abline(h = 1.0, col = "grey60", lty = 2, lwd = 1.8)
# Predictive ESS / S trajectories:
lines(S_vals, eff_pred_m1, col = COL_M1, lwd = 3.4, lty = 1)
points(S_vals, eff_pred_m1, col = COL_M1, pch = 19, cex = 1.7)
lines(S_vals, eff_pred_m2, col = COL_M2, lwd = 3.4, lty = 2)
points(S_vals, eff_pred_m2, col = COL_M2, pch = 1, cex = 1.7, lwd = 2.2)
# Parameter min ESS / S trajectories:
lines(S_vals, eff_param_m1, col = COL_M1_SEC, lwd = 3.0, lty = 3)
points(S_vals, eff_param_m1, col = COL_M1_SEC, pch = 17, cex = 1.5)
lines(S_vals, eff_param_m2, col = COL_M2_SEC, lwd = 3.0, lty = 3)
points(S_vals, eff_param_m2, col = COL_M2_SEC, pch = 2, cex = 1.5, lwd = 2.0)
legend("topright", inset = c(0.025, 0.025),
legend = c(
expression(italic(M)[1] ~ "(Joint):" ~ widehat(ESS)[ELJPD] / italic(S)),
expression(italic(M)[2] ~ "(Separate):" ~ widehat(ESS)[ELJPD] / italic(S)),
expression(italic(M)[1] ~ "(Joint):" ~ min[italic(j)] ~ widehat(ESS)(xi[italic(j)]) / italic(S)),
expression(italic(M)[2] ~ "(Separate):" ~ min[italic(j)] ~ widehat(ESS)(xi[italic(j)]) / italic(S)),
expression("Full Efficiency (" * widehat(ESS) / italic(S) == 1.0 * ")")
),
col    = c(COL_M1, COL_M2, COL_M1_SEC, COL_M2_SEC, "grey60"),
pch    = c(19, 1, 17, 2, NA),
lty    = c(1, 2, 3, 3, 2),
lwd    = c(3.4, 3.4, 3.0, 3.0, 1.8),
pt.cex = c(1.7, 1.7, 1.5, 1.5, NA),
pt.lwd = c(NA, 2.2, NA, 2.0, NA),
bty    = "o", bg = adjustcolor("white", 0.94), box.col = COL_BOX,
cex    = legend_cex, y.intersp = 1.15)
box(lwd = 1.8)
}
# ------------------------------------------------------------------------------
# 6. Generate Side-by-Side 2-Panel Publication Figure
# ------------------------------------------------------------------------------
plot_side_by_side <- function() {
par(
mfrow    = c(1, 2),
mar      = c(5.8, 9.2, 2.5, 2.0),
oma      = c(0.5, 0.5, 0.5, 0.5),
mgp      = c(3.8, 1.4, 0),
cex.lab  = 2.4,
cex.axis = 1.8,
las      = 1
)
render_panel_a(legend_cex = 1.40)
render_panel_b(legend_cex = 1.25)
}
# Publication side-by-side files
side_pdf_names <- c("elpd_side_by_side_separation.pdf",
"elppd_side_by_side_separation.pdf",
"elpd_mcse.pdf",
"elppd_mcse.pdf",
"elppd_tracking_ess.pdf")
cat("--- Generating Publication Figures ---\n")
for (fn in side_pdf_names) {
pdf(fn, width = 20, height = 9.5, useDingbats = FALSE)
plot_side_by_side()
dev.off()
png_fn <- sub("\\.pdf$", ".png", fn)
png(png_fn, width = 3200, height = 1520, res = 160)
plot_side_by_side()
dev.off()
cat(sprintf("  Saved side-by-side figure: %s and %s\n", fn, png_fn))
}
# ------------------------------------------------------------------------------
# 7. Generate Standalone Figures
# ------------------------------------------------------------------------------
plot_standalone <- function(render_fun, legend_cex = 1.30) {
par(
mar      = c(5.8, 9.2, 2.0, 2.0),
oma      = c(0.2, 0.2, 0.2, 0.2),
mgp      = c(3.8, 1.4, 0),
cex.lab  = 2.3,
cex.axis = 1.8,
las      = 1
)
render_fun(legend_cex = legend_cex)
}
# Standalone Panel (a): ELPD Tracking & Separation
pdf("elpd_tracking_separation.pdf", width = 11, height = 9, useDingbats = FALSE)
plot_standalone(render_panel_a, legend_cex = 1.45)
dev.off()
png("elpd_tracking_separation.png", width = 1800, height = 1450, res = 160)
plot_standalone(render_panel_a, legend_cex = 1.45)
dev.off()
cat("  Saved standalone figure: elpd_tracking_separation.pdf & .png\n")
# Standalone Panel (b): ESS / S Relative Efficiency
pdf("ess_s_ratio.pdf", width = 11, height = 9, useDingbats = FALSE)
plot_standalone(render_panel_b, legend_cex = 1.35)
dev.off()
png("ess_s_ratio.png", width = 1800, height = 1450, res = 160)
plot_standalone(render_panel_b, legend_cex = 1.35)
dev.off()
cat("  Saved standalone figure: ess_s_ratio.pdf & .png\n\n")
cat("==============================================================================\n")
cat("Output Analysis and Plot Generation Completed Successfully!\n")
cat("==============================================================================\n")
## ==============================================================================
## output_analysis.R
## Real Data Analysis: US Wildfire Study (Mainland US, N = 3,503 grid cells)
## Mixed Responses: BA (Burned Area, Gaussian) & CNT (Wildfire Count, Poisson)
## Model Comparison via K-Fold Cross-Validation:
##   - Model M1: Joint Covariance Model (Separable Cross-Covariance Matern GP)
##   - Model M2: Separate Covariance Model (Independent Univariate GPs)
##
## Features:
##   * Dynamically learns S_star, S_max, S_step, S_vals, k.folds, and m from RData files
##   * Computes asymptotic 95% Monte Carlo confidence intervals for ELPD tracking
##   * Data-adaptive separation detection: identifies empirical separation point S_sep
##   * Evaluates Predictive vs Parameter Relative Efficiency ratios: widehat(ESS) / S
##   * Outputs:
##       - elpd_side_by_side_separation.pdf & .png (2-panel publication figure)
##       - elpd_tracking_separation.pdf & .png     (Standalone Panel a)
##       - ess_s_ratio.pdf & .png                  (Standalone Panel b)
##       - Mirrored publication aliases (elpd_mcse.pdf, elppd_tracking_ess.pdf)
## ==============================================================================
rm(list = ls())
invisible(gc())
if (requireNamespace("this.path", quietly = TRUE)) {
setwd(this.path::here())
}
# ------------------------------------------------------------------------------
# 1. Load Model Outputs and Dynamically Learn Grid Specifications
# ------------------------------------------------------------------------------
cat("==============================================================================\n")
cat("Real Data Analysis: Model Comparison & Convergence Diagnostics\n")
cat("==============================================================================\n\n")
file_m1_candidates <- c("M1_outputs.RData", file.path("M1_estimation", "M1_outputs.RData"))
file_m2_candidates <- c("M2_outputs.RData", file.path("M2_estimation", "M2_outputs.RData"))
file_m1 <- file_m1_candidates[file.exists(file_m1_candidates)][1]
file_m2 <- file_m2_candidates[file.exists(file_m2_candidates)][1]
if (is.na(file_m1) || is.na(file_m2)) {
stop("Output files missing! Please ensure M1_outputs.RData and M2_outputs.RData are present.")
}
env_m1 <- new.env()
env_m2 <- new.env()
load(file_m1, envir = env_m1)
load(file_m2, envir = env_m2)
h1 <- as.data.frame(env_m1$history)
h2 <- as.data.frame(env_m2$history)
# Robust field accessors for history columns
extract_field <- function(df, candidates, default = NULL) {
for (cand in candidates) {
if (cand %in% names(df)) return(df[[cand]])
}
return(default)
}
h1_elpd      <- extract_field(h1, c("eljpd_hat", "elpd_hat"))
h1_asymp_se  <- extract_field(h1, c("asymp_se", "se"))
h1_ess_pred  <- extract_field(h1, c("ess_elpd", "ess"))
h1_min_ess   <- extract_field(h1, c("minESS_xi"), default = rep(NA_real_, nrow(h1)))
h2_elpd      <- extract_field(h2, c("eljpd_hat", "elpd_hat"))
h2_asymp_se  <- extract_field(h2, c("asymp_se", "se"))
h2_ess_pred  <- extract_field(h2, c("ess_elpd", "ess"))
h2_min_ess   <- extract_field(h2, c("minESS_xi"), default = rep(NA_real_, nrow(h2)))
# Learn S_star, S_max, S_step, and checkpoints dynamically from RData
S_vals <- h1$S
S_star <- if (exists("S_star", envir = env_m1)) env_m1$S_star else min(S_vals)
S_max  <- if (exists("S_max", envir = env_m1)) env_m1$S_max else max(S_vals)
S_step <- if (length(S_vals) > 1) diff(S_vals)[1] else NA_real_
n_checkpoints <- length(S_vals)
k_folds   <- if (exists("k.folds", envir = env_m1)) env_m1$k.folds else 10
m_vecchia <- if (exists("m", envir = env_m1)) env_m1$m else 20
acc_m1 <- if (exists("acc.phi", envir = env_m1)) env_m1$acc.phi else if (exists("acc_phi", envir = env_m1)) env_m1$acc_phi else NA_real_
acc_m2 <- if (exists("acc.phi", envir = env_m2)) env_m2$acc.phi else if (exists("acc_phi", envir = env_m2)) env_m2$acc_phi else NA_real_
cat(sprintf("Loaded M1 from '%s' | M2 from '%s'\n", file_m1, file_m2))
cat(sprintf("Parameters: K-folds = %d, Vecchia conditioning m = %d\n", k_folds, m_vecchia))
cat(sprintf("Iterations: S_star = %s, S_max = %s, S_step = %s (%d checkpoints)\n",
format(as.integer(S_star), big.mark = ","),
format(as.integer(S_max), big.mark = ","),
format(as.integer(S_step), big.mark = ","),
n_checkpoints))
cat(sprintf("Metropolis acceptance rate (phi): M1 = %.4f, M2 = %.4f\n\n", acc_m1, acc_m2))
# ------------------------------------------------------------------------------
# 2. Performance and Convergence Summary at S_max
# ------------------------------------------------------------------------------
last_k <- length(S_vals)
summary_df <- data.frame(
Model          = c("M1 (Joint Model)", "M2 (Separate Model)"),
Specification  = c("", ""),
S_max          = c(format(as.integer(S_vals[last_k]), big.mark = ","),
format(as.integer(S_vals[last_k]), big.mark = ",")),
ELPD_hat       = round(c(h1_elpd[last_k], h2_elpd[last_k]), 2),
MCSE           = round(c(h1_asymp_se[last_k], h2_asymp_se[last_k]), 3),
ESS_pred       = round(c(h1_ess_pred[last_k], h2_ess_pred[last_k]), 1),
Pred_Eff_Ratio = round(c(h1_ess_pred[last_k] / S_vals[last_k], h2_ess_pred[last_k] / S_vals[last_k]), 4),
min_ESS_param  = round(c(h1_min_ess[last_k], h2_min_ess[last_k]), 2),
Param_Eff_Ratio= format(c(h1_min_ess[last_k] / S_vals[last_k], h2_min_ess[last_k] / S_vals[last_k]), scientific = TRUE, digits = 3)
)
cat("--- Model Convergence Summary at S_max ---\n")
print(summary_df, row.names = FALSE)
cat("\n")
# Model Comparison Difference (M1 - M2)
delta_elpd <- h1_elpd[last_k] - h2_elpd[last_k]
mcse_delta <- sqrt(h1_asymp_se[last_k]^2 + h2_asymp_se[last_k]^2)
z_delta    <- abs(delta_elpd) / mcse_delta
p_delta    <- 2 * (1 - pnorm(z_delta))
ci_lo      <- delta_elpd - 1.96 * mcse_delta
ci_hi      <- delta_elpd + 1.96 * mcse_delta
cat("--- Out-of-Sample Predictive Comparison ---\n")
cat(sprintf("  Delta ELPD (M1 - M2) : %+10.3f\n", delta_elpd))
cat(sprintf("  Monte Carlo SE       : %10.3f\n", mcse_delta))
cat(sprintf("  95%% MC Confidence Int: [%.3f, %.3f]\n", ci_lo, ci_hi))
cat(sprintf("  Z-score              : %10.2f (p = %s)\n", z_delta, format.pval(p_delta, digits = 3)))
if (delta_elpd > 0 && ci_lo > 0) {
cat("  Conclusion           : Model M1 (Joint) significantly outperforms Model M2 (Separate)!\n\n")
} else if (delta_elpd < 0 && ci_hi < 0) {
cat("  Conclusion           : Model M2 (Separate) significantly outperforms Model M1 (Joint)!\n\n")
} else {
cat("  Conclusion           : No statistically significant difference detected.\n\n")
}
# ------------------------------------------------------------------------------
# 3. Data-Adaptive Separation Detection (S_sep)
# ------------------------------------------------------------------------------
z_crit <- qnorm(0.975) # 1.959964
hw1 <- z_crit * h1_asymp_se
hw2 <- z_crit * h2_asymp_se
m1_lo <- h1_elpd - hw1
m1_hi <- h1_elpd + hw1
m2_lo <- h2_elpd - hw2
m2_hi <- h2_elpd + hw2
## Data-adaptive separation point S_sep:
## Identifies earliest checkpoint S after which the superior model (at S_max)
## maintains strictly disjoint confidence intervals over the competing model through S_max.
## In early iterations (5K - 65K), finite-sample importance sampling bias causes
## trajectories to cross/oscillate; true asymptotic separation is established once
## the dominating model stays permanently ahead through S_max.
compute_S_sep <- function(lo1, hi1, lo2, hi2, S_vec, elpd1 = NULL, elpd2 = NULL) {
last_k <- length(S_vec)
m1_wins <- if (!is.null(elpd1) && !is.null(elpd2)) {
elpd1[last_k] >= elpd2[last_k]
} else {
hi1[last_k] >= hi2[last_k]
}
is_sep <- if (m1_wins) (lo1 > hi2) else (lo2 > hi1)
if (length(is_sep) > 0 && is_sep[last_k]) {
fi <- which(!is_sep)
k_sep <- if (length(fi) == 0) 1L else max(fi) + 1L
return(S_vec[k_sep])
}
return(NA_real_)
}
sep_S <- compute_S_sep(m1_lo, m1_hi, m2_lo, m2_hi, S_vals, h1_elpd, h2_elpd)
m1_wins     <- h1_elpd[last_k] >= h2_elpd[last_k]
winner_name <- if (m1_wins) "M1 (Joint)" else "M2 (Separate)"
loser_name  <- if (m1_wins) "M2 (Separate)" else "M1 (Joint)"
winner_lo   <- if (m1_wins) m1_lo else m2_lo
loser_hi    <- if (m1_wins) m2_hi else m1_hi
cat("--- Empirical Separation Point Analysis ---\n")
if (!is.na(sep_S)) {
k_sep <- which(S_vals == sep_S)
gap_sep <- winner_lo[k_sep] - loser_hi[k_sep]
sep_k_str <- if (sep_S >= 1000) sprintf(" (%sK)", format(as.integer(sep_S / 1000))) else ""
cat(sprintf("  Superior model       : %s\n", winner_name))
cat(sprintf("  Empirical separation attained at S_sep = %s iterations%s!\n",
format(as.integer(sep_S), big.mark = ","),
sep_k_str))
cat(sprintf("  At S = %s:\n", format(as.integer(sep_S), big.mark = ",")))
cat(sprintf("    %s lower 95%% bound : %.2f\n", winner_name, winner_lo[k_sep]))
cat(sprintf("    %s upper 95%% bound : %.2f\n", loser_name, loser_hi[k_sep]))
cat(sprintf("    Strict separation gap : +%.2f (ELPD units)\n", gap_sep))
cat(sprintf("  Separation holds permanently from S = %s through S_max = %s.\n",
format(as.integer(sep_S), big.mark = ","),
format(as.integer(S_max), big.mark = ",")))
# Document stabilization plateau around 80K
if (any(S_vals == 80000)) {
k_80 <- which(S_vals == 80000)
gap_80 <- winner_lo[k_80] - loser_hi[k_80]
cat(sprintf("  Asymptotic stabilization plateau reached at S = 80,000 (80K):\n"))
cat(sprintf("    %s lower 95%% bound : %.2f\n", winner_name, winner_lo[k_80]))
cat(sprintf("    %s upper 95%% bound : %.2f\n", loser_name, loser_hi[k_80]))
cat(sprintf("    Stationary separation gap : +%.2f (ELPD units)\n\n", gap_80))
} else {
cat("\n")
}
} else {
cat("  Confidence intervals continue to overlap up to S_max; no complete separation attained.\n\n")
}
# ------------------------------------------------------------------------------
# 4. Color Palette and Visual Styling (Publication Standards)
# ------------------------------------------------------------------------------
COL_M1      <- "#08519C"   # Deep royal blue (M1 Joint)
COL_M2      <- "#D73027"   # Deep crimson red (M2 Separate)
COL_SEP     <- "#006837"   # Dark forest green (Separation boundary)
COL_GRID    <- "grey92"    # Subtle background grid lines
COL_BOX     <- "grey75"    # Subtle legend box border
COL_M1_SEC  <- "#2171B5"   # Steel blue for parameter ESS (M1)
COL_M2_SEC  <- "#FC8D59"   # Soft coral for parameter ESS (M2)
# Unified horizontal axes:
xlim_common <- range(S_vals)
s_ticks     <- pretty(S_vals, n = 6)
s_ticks     <- s_ticks[s_ticks >= S_star & s_ticks <= S_max]
if (length(s_ticks) < 2) s_ticks <- S_vals
s_labels    <- if (S_max >= 1000) paste0(s_ticks / 1000, "K") else as.character(s_ticks)
# Vertical axis for Panel (a) ELPD:
elpd_all_lo <- min(c(m1_lo, m2_lo), na.rm = TRUE)
elpd_all_hi <- max(c(m1_hi, m2_hi), na.rm = TRUE)
y_range_elpd<- elpd_all_hi - elpd_all_lo
if (y_range_elpd < 1e-4) y_range_elpd <- 10.0
y_ticks_elpd  <- pretty(c(elpd_all_lo - 0.05 * y_range_elpd, elpd_all_hi + 0.32 * y_range_elpd), n = 7)
ylim_elpd     <- range(y_ticks_elpd)
y_labels_elpd <- format(y_ticks_elpd, big.mark = ",")
# Relative efficiency ratios: ESS / S
eff_pred_m1  <- h1_ess_pred / S_vals
eff_pred_m2  <- h2_ess_pred / S_vals
eff_param_m1 <- h1_min_ess / S_vals
eff_param_m2 <- h2_min_ess / S_vals
# Vertical axis for Panel (b) ESS/S (data-adaptive with headroom for top-right legend):
ratio_all_lo <- min(c(0, eff_pred_m1, eff_pred_m2, eff_param_m1, eff_param_m2), na.rm = TRUE)
ratio_all_hi <- max(c(eff_pred_m1, eff_pred_m2, eff_param_m1, eff_param_m2), na.rm = TRUE)
if (!is.finite(ratio_all_hi) || ratio_all_hi <= 0) ratio_all_hi <- 1.0
y_range_ratio <- ratio_all_hi - ratio_all_lo
y_ticks_ratio  <- pretty(c(ratio_all_lo, ratio_all_hi + 0.42 * y_range_ratio), n = 6)
y_ticks_ratio  <- y_ticks_ratio[y_ticks_ratio >= 0]
ylim_ratio     <- range(y_ticks_ratio)
y_labels_ratio <- if (max(y_ticks_ratio) >= 10) {
format(y_ticks_ratio, trim = TRUE, big.mark = ",")
} else {
sprintf("%.2f", y_ticks_ratio)
}
# ------------------------------------------------------------------------------
# 5. Core Plotting Functions
# ------------------------------------------------------------------------------
# Panel (a): ELPD Tracking with 95% CIs and Separation Point
render_panel_a <- function(legend_cex = 1.40) {
plot(NA, xlim = xlim_common, ylim = ylim_elpd,
xlab = expression("Iterations (" * italic(S) * ")"),
ylab = "",
main = "", xaxt = "n", yaxt = "n")
title(ylab = expression(widehat(ELJPD)(italic(S))), line = 6.2)
axis(1, at = s_ticks, labels = s_labels, gap.axis = 0)
axis(2, at = y_ticks_elpd, labels = y_labels_elpd)
abline(h = y_ticks_elpd, col = COL_GRID, lty = 1, lwd = 0.8)
abline(v = s_ticks,      col = COL_GRID, lty = 1, lwd = 0.8)
# Vertical separation boundary
if (!is.na(sep_S)) {
abline(v = sep_S, col = COL_SEP, lty = 4, lwd = 3.2)
}
# Pointwise 95% CI error bar arrows
arrows(S_vals, m1_lo, S_vals, pmin(m1_hi, ylim_elpd[2]),
code = 3, angle = 90, length = 0.06,
col = adjustcolor(COL_M1, 0.45), lwd = 2.4)
arrows(S_vals, m2_lo, S_vals, pmin(m2_hi, ylim_elpd[2]),
code = 3, angle = 90, length = 0.06,
col = adjustcolor(COL_M2, 0.50), lwd = 2.4)
# Model trajectories:
# M1 (Joint): solid line, filled circle
lines(S_vals, h1_elpd, col = COL_M1, lwd = 3.5, lty = 1)
points(S_vals, h1_elpd, col = COL_M1, pch = 19, cex = 1.7)
# M2 (Separate): solid line, open circle
lines(S_vals, h2_elpd, col = COL_M2, lwd = 3.5, lty = 1)
points(S_vals, h2_elpd, col = COL_M2, pch = 1, cex = 1.7, lwd = 2.2)
# Legend
sep_txt <- if (!is.na(sep_S)) {
bquote("Separation (" * italic(S)[sep] == .(format(as.integer(sep_S), big.mark = ",")) * ")")
} else {
expression("No separation")
}
legend("topright", inset = c(0.025, 0.025),
legend = c(
expression(italic(M)[1] ~ "(Joint Model)"),
expression(italic(M)[2] ~ "(Separate Model)"),
sep_txt
),
col    = c(COL_M1, COL_M2, COL_SEP),
pch    = c(19, 1, NA),
lty    = c(1, 1, 4),
lwd    = c(3.2, 3.2, 3.2),
pt.cex = c(1.7, 1.7, NA),
pt.lwd = c(NA, 2.2, NA),
bty    = "o", bg = adjustcolor("white", 0.94), box.col = COL_BOX,
cex    = legend_cex, y.intersp = 1.15)
box(lwd = 1.8)
}
# Panel (b): Relative Efficiency (ESS / S) Plot
render_panel_b <- function(legend_cex = 1.25) {
plot(NA, xlim = xlim_common, ylim = ylim_ratio,
xlab = expression("Iterations (" * italic(S) * ")"),
ylab = "",
main = "", xaxt = "n", yaxt = "n")
title(ylab = expression(widehat(ESS)(italic(S)) / italic(S)), line = 4.8)
axis(1, at = s_ticks, labels = s_labels, gap.axis = 0)
axis(2, at = y_ticks_ratio, labels = y_labels_ratio)
abline(h = y_ticks_ratio, col = COL_GRID, lty = 1, lwd = 0.8)
abline(v = s_ticks,       col = COL_GRID, lty = 1, lwd = 0.8)
# Vertical separation boundary
if (!is.na(sep_S)) {
abline(v = sep_S, col = COL_SEP, lty = 4, lwd = 3.2)
}
# Reference line at ratio = 1.0 (Full Monte Carlo Efficiency)
abline(h = 1.0, col = "grey60", lty = 2, lwd = 1.8)
# Predictive ESS / S trajectories:
lines(S_vals, eff_pred_m1, col = COL_M1, lwd = 3.4, lty = 1)
points(S_vals, eff_pred_m1, col = COL_M1, pch = 19, cex = 1.7)
lines(S_vals, eff_pred_m2, col = COL_M2, lwd = 3.4, lty = 2)
points(S_vals, eff_pred_m2, col = COL_M2, pch = 1, cex = 1.7, lwd = 2.2)
# Parameter min ESS / S trajectories:
lines(S_vals, eff_param_m1, col = COL_M1_SEC, lwd = 3.0, lty = 3)
points(S_vals, eff_param_m1, col = COL_M1_SEC, pch = 17, cex = 1.5)
lines(S_vals, eff_param_m2, col = COL_M2_SEC, lwd = 3.0, lty = 3)
points(S_vals, eff_param_m2, col = COL_M2_SEC, pch = 2, cex = 1.5, lwd = 2.0)
legend("topright", inset = c(0.025, 0.025),
legend = c(
expression(italic(M)[1] ~ "(Joint):" ~ widehat(ESS)[ELJPD] / italic(S)),
expression(italic(M)[2] ~ "(Separate):" ~ widehat(ESS)[ELJPD] / italic(S)),
expression(italic(M)[1] ~ "(Joint):" ~ min[italic(j)] ~ widehat(ESS)(xi[italic(j)]) / italic(S)),
expression(italic(M)[2] ~ "(Separate):" ~ min[italic(j)] ~ widehat(ESS)(xi[italic(j)]) / italic(S)),
expression("Full Efficiency (" * widehat(ESS) / italic(S) == 1.0 * ")")
),
col    = c(COL_M1, COL_M2, COL_M1_SEC, COL_M2_SEC, "grey60"),
pch    = c(19, 1, 17, 2, NA),
lty    = c(1, 2, 3, 3, 2),
lwd    = c(3.4, 3.4, 3.0, 3.0, 1.8),
pt.cex = c(1.7, 1.7, 1.5, 1.5, NA),
pt.lwd = c(NA, 2.2, NA, 2.0, NA),
bty    = "o", bg = adjustcolor("white", 0.94), box.col = COL_BOX,
cex    = legend_cex, y.intersp = 1.15)
box(lwd = 1.8)
}
# ------------------------------------------------------------------------------
# 6. Generate Side-by-Side 2-Panel Publication Figure
# ------------------------------------------------------------------------------
plot_side_by_side <- function() {
par(
mfrow    = c(1, 2),
mar      = c(5.8, 9.2, 2.5, 2.0),
oma      = c(0.5, 0.5, 0.5, 0.5),
mgp      = c(3.8, 1.4, 0),
cex.lab  = 2.4,
cex.axis = 1.8,
las      = 1
)
render_panel_a(legend_cex = 1.40)
render_panel_b(legend_cex = 1.25)
}
# Publication side-by-side files
side_pdf_names <- c("elpd_side_by_side_separation.pdf",
"elppd_side_by_side_separation.pdf",
"elpd_mcse.pdf",
"elppd_mcse.pdf",
"elppd_tracking_ess.pdf")
cat("--- Generating Publication Figures ---\n")
for (fn in side_pdf_names) {
pdf(fn, width = 20, height = 9.5, useDingbats = FALSE)
plot_side_by_side()
dev.off()
png_fn <- sub("\\.pdf$", ".png", fn)
png(png_fn, width = 3200, height = 1520, res = 160)
plot_side_by_side()
dev.off()
cat(sprintf("  Saved side-by-side figure: %s and %s\n", fn, png_fn))
}
# ------------------------------------------------------------------------------
# 7. Generate Standalone Figures
# ------------------------------------------------------------------------------
plot_standalone <- function(render_fun, legend_cex = 1.30) {
par(
mar      = c(5.8, 9.2, 2.0, 2.0),
oma      = c(0.2, 0.2, 0.2, 0.2),
mgp      = c(3.8, 1.4, 0),
cex.lab  = 2.3,
cex.axis = 1.8,
las      = 1
)
render_fun(legend_cex = legend_cex)
}
# Standalone Panel (a): ELPD Tracking & Separation
pdf("elpd_tracking_separation.pdf", width = 11, height = 9, useDingbats = FALSE)
plot_standalone(render_panel_a, legend_cex = 1.45)
dev.off()
png("elpd_tracking_separation.png", width = 1800, height = 1450, res = 160)
plot_standalone(render_panel_a, legend_cex = 1.45)
dev.off()
cat("  Saved standalone figure: elpd_tracking_separation.pdf & .png\n")
# Standalone Panel (b): ESS / S Relative Efficiency
pdf("ess_s_ratio.pdf", width = 11, height = 9, useDingbats = FALSE)
plot_standalone(render_panel_b, legend_cex = 1.35)
dev.off()
png("ess_s_ratio.png", width = 1800, height = 1450, res = 160)
plot_standalone(render_panel_b, legend_cex = 1.35)
dev.off()
cat("  Saved standalone figure: ess_s_ratio.pdf & .png\n\n")
cat("==============================================================================\n")
cat("Output Analysis and Plot Generation Completed Successfully!\n")
cat("==============================================================================\n")
