m          <- 20
t.index    <- 140
burnin     <- 0
S_star     <- 5e2
S_max      <- 5e2
S_step     <- 5e2
S_vals     <- seq(S_star, S_max, by = S_step)
tuning.phi <- 1e-2
# ---- Data & Model Specs ------------------------------------------------------
data.file <- if (file.exists("data_full.RData")) "data_full.RData" else file.path("..", "data_full.RData")
load(data.file, eva.data <- new.env())
full.data.DF <- eva.data$data_DF
N.s <- 3503
spatial.subset <- seq(N.s * (t.index - 1) + 1, N.s * t.index)
data <- full.data.DF[spatial.subset, ]
locations <- cbind(data$lon, data$lat)
X <- cbind(1, locations)
Y <- cbind(log(1 + data$BA), data$CNT)
N <- nrow(Y); p <- ncol(X); q <- ncol(Y)
family <- c("Gaussian", "Poisson")
fold_id <- sample(rep(seq_len(k.folds), length.out = N))
# Vecchia ordering across all locations
ord      <- max_min(locations)
locs.ord <- locations[ord, , drop = FALSE]
X.ord    <- X[ord, , drop = FALSE]
Y.ord    <- Y[ord, , drop = FALSE]
fold.ord <- fold_id[ord]
NNarray <- neighbor_matrix(locs.ord, m)
storage.mode(NNarray) <- "integer"
# Precompute test nearest neighbors for all folds
test_nn_list <- vector("list", k.folds)
for (k in seq_len(k.folds)) {
test_idx  <- which(fold.ord == k) - 1
train_idx <- which(fold.ord != k) - 1
knn <- get.knnx(locs.ord[train_idx + 1, , drop = FALSE],
locs.ord[test_idx + 1, , drop = FALSE],
k = m)
test_nn_list[[k]] <- list(
test_idx = as.integer(test_idx),
nn_idx   = matrix(as.integer(train_idx[knn$nn.index]),
nrow = length(test_idx), ncol = m)
)
}
b_phi <- max(rdist(locs.ord)) / 3
M.prior  <- matrix(0, p, q)
V.prior  <- 1e2 * diag(p)
S.prior  <- diag(q)
df.prior <- q + 1
W.init <- cbind(Y.ord[, 1], log(1 + Y.ord[, 2]))
Sigma  <- cov(W.init)
beta   <- solve(crossprod(X.ord)) %*% crossprod(X.ord, W.init)
# Variogram-based initialization for phi and nu
R.chol   <- chol(Sigma)
W.white  <- W.init %*% solve(R.chol)
df.joint <- data.frame(lon = rep(locs.ord[, 1], q), lat = rep(locs.ord[, 2], q),
values = as.vector(W.white))
coordinates(df.joint) <- ~ lon + lat
emp.vario.joint <- variogram(values ~ 1, df.joint)
init.vgm <- vgm(model = "Mat", psill = var(df.joint$values),
range = median(emp.vario.joint$dist), nugget = 0)
fit.vgm <- fit.variogram(emp.vario.joint, model = init.vgm, fit.sills = TRUE)
phi <- fit.vgm$range[2]
nu  <- fit.vgm$kappa[2]
cat(sprintf("Model M1 setup: N = %d, q = %d, K = %d, phi0 = %.4f, nu = %.3f\n",
N, q, k.folds, phi, nu))
# ---- Gibbs Sampling on q_mix -------------------------------------------------
cat(sprintf("Running Gibbs sampler on q_mix: burnin = %d, S = %d...\n", burnin, S_max))
t_start <- proc.time()
fit <- gibbs_kfold_joint_cpp(
Y = Y.ord, X = X.ord, locs = locs.ord, NNarray = NNarray,
fold = as.integer(fold.ord), K = k.folds,
test_nn_list = test_nn_list,
family = family, family_par = rep(NA_real_, q),
nu = nu, phi_init = phi, beta_init = beta, Sigma_init = Sigma, W_init = W.init,
M_prior = M.prior, V_prior = V.prior, S_prior = S.prior, df_prior = df.prior,
b_phi = b_phi, tuning_phi = tuning.phi, niters = S_max, burnin = burnin,
progress_every = 50
)
# Model M1 (Joint Covariance): K-fold ELJPD via Gibbs sampling from q_mix
rm(list = ls())
invisible(gc())
set.seed(35)
libraries <- c("fields", "FNN", "mcmcse", "coda", "sp", "gstat", "this.path",
"Rcpp", "RcppArmadillo")
invisible(lapply(libraries, library, character.only = TRUE))
if (requireNamespace("this.path", quietly = TRUE)) {
setwd(this.path::here())
}
Sys.setenv(R_MAKEVARS_USER = normalizePath("../../Makevars"))
source("vecchia.R")
source("aux_functions_joint.R")
source("eljpd.utils.R")
Rcpp::sourceCpp("gibbs_kfold_joint.cpp")
# ---- Parameters --------------------------------------------------------------
k.folds    <- 10
m          <- 20
t.index    <- 140
burnin     <- 0
S_star     <- 5e2
S_max      <- 5e2
S_step     <- 5e2
S_vals     <- seq(S_star, S_max, by = S_step)
tuning.phi <- 2e-2
# ---- Data & Model Specs ------------------------------------------------------
data.file <- if (file.exists("data_full.RData")) "data_full.RData" else file.path("..", "data_full.RData")
load(data.file, eva.data <- new.env())
full.data.DF <- eva.data$data_DF
N.s <- 3503
spatial.subset <- seq(N.s * (t.index - 1) + 1, N.s * t.index)
data <- full.data.DF[spatial.subset, ]
locations <- cbind(data$lon, data$lat)
X <- cbind(1, locations)
Y <- cbind(log(1 + data$BA), data$CNT)
N <- nrow(Y); p <- ncol(X); q <- ncol(Y)
family <- c("Gaussian", "Poisson")
fold_id <- sample(rep(seq_len(k.folds), length.out = N))
# Vecchia ordering across all locations
ord      <- max_min(locations)
locs.ord <- locations[ord, , drop = FALSE]
X.ord    <- X[ord, , drop = FALSE]
Y.ord    <- Y[ord, , drop = FALSE]
fold.ord <- fold_id[ord]
NNarray <- neighbor_matrix(locs.ord, m)
storage.mode(NNarray) <- "integer"
# Precompute test nearest neighbors for all folds
test_nn_list <- vector("list", k.folds)
for (k in seq_len(k.folds)) {
test_idx  <- which(fold.ord == k) - 1
train_idx <- which(fold.ord != k) - 1
knn <- get.knnx(locs.ord[train_idx + 1, , drop = FALSE],
locs.ord[test_idx + 1, , drop = FALSE],
k = m)
test_nn_list[[k]] <- list(
test_idx = as.integer(test_idx),
nn_idx   = matrix(as.integer(train_idx[knn$nn.index]),
nrow = length(test_idx), ncol = m)
)
}
b_phi <- max(rdist(locs.ord)) / 3
M.prior  <- matrix(0, p, q)
V.prior  <- 1e2 * diag(p)
S.prior  <- diag(q)
df.prior <- q + 1
W.init <- cbind(Y.ord[, 1], log(1 + Y.ord[, 2]))
Sigma  <- cov(W.init)
beta   <- solve(crossprod(X.ord)) %*% crossprod(X.ord, W.init)
# Variogram-based initialization for phi and nu
R.chol   <- chol(Sigma)
W.white  <- W.init %*% solve(R.chol)
df.joint <- data.frame(lon = rep(locs.ord[, 1], q), lat = rep(locs.ord[, 2], q),
values = as.vector(W.white))
coordinates(df.joint) <- ~ lon + lat
emp.vario.joint <- variogram(values ~ 1, df.joint)
init.vgm <- vgm(model = "Mat", psill = var(df.joint$values),
range = median(emp.vario.joint$dist), nugget = 0)
fit.vgm <- fit.variogram(emp.vario.joint, model = init.vgm, fit.sills = TRUE)
phi <- fit.vgm$range[2]
nu  <- fit.vgm$kappa[2]
cat(sprintf("Model M1 setup: N = %d, q = %d, K = %d, phi0 = %.4f, nu = %.3f\n",
N, q, k.folds, phi, nu))
# ---- Gibbs Sampling on q_mix -------------------------------------------------
cat(sprintf("Running Gibbs sampler on q_mix: burnin = %d, S = %d...\n", burnin, S_max))
t_start <- proc.time()
fit <- gibbs_kfold_joint_cpp(
Y = Y.ord, X = X.ord, locs = locs.ord, NNarray = NNarray,
fold = as.integer(fold.ord), K = k.folds,
test_nn_list = test_nn_list,
family = family, family_par = rep(NA_real_, q),
nu = nu, phi_init = phi, beta_init = beta, Sigma_init = Sigma, W_init = W.init,
M_prior = M.prior, V_prior = V.prior, S_prior = S.prior, df_prior = df.prior,
b_phi = b_phi, tuning_phi = tuning.phi, niters = S_max, burnin = burnin,
progress_every = 50
)
t_elapsed <- (proc.time() - t_start)[3]
acc.phi <- fit$acc.phi
acc_phi <- acc.phi
cat(sprintf("Gibbs sampling finished in %.2f s. acc.phi = %.4f\n",
t_elapsed, acc.phi))
fold.visits <- tabulate(fit$folds, nbins = k.folds) / S_max
cat("Proportion of draws per fold index:\n")
print(round(fold.visits, 4))
# ---- Sequential ELJPD History ------------------------------------------------
cat("Evaluating sequential ELJPD and MCSE checkpoints...\n")
history <- list(
S         = numeric(),
ess_eljpd = numeric(),
minESS_xi = numeric(),
eljpd_hat = numeric(),
asymp_se  = numeric()
)
for (S_curr in S_vals) {
out <- eljpd_kfold_joint(fit$fold_loglik, S_curr = S_curr, samples = fit$theta)
history$S         <- c(history$S,         S_curr)
history$ess_eljpd <- c(history$ess_eljpd, out$ess_eljpd)
history$minESS_xi <- c(history$minESS_xi, out$minESS_xi)
history$eljpd_hat <- c(history$eljpd_hat, out$eljpd)
history$asymp_se  <- c(history$asymp_se,  out$asymp_se)
}
print(data.frame(
S         = history$S,
eljpd_hat = round(history$eljpd_hat, 3),
asymp_se  = round(history$asymp_se, 4),
ess_eljpd = round(history$ess_eljpd, 1),
minESS_xi = round(history$minESS_xi, 1)
))
final <- eljpd_kfold_joint(fit$fold_loglik, samples = fit$theta)
eljpd_fold <- final$eljpd_fold
cat(sprintf("\nM1 Final ELJPD = %.3f  (Asymptotic SE = %.3f)\n",
final$eljpd, final$asymp_se))
# ---- Save --------------------------------------------------------------------
save(
history,
final,
eljpd_fold,
acc.phi,
acc_phi,
k.folds,
m,
burnin,
S_max,
fold.visits,
file = "M1_outputs.RData"
)
cat("Results saved to M1_outputs.RData\n")
