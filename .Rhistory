# Zanella (self-normalized mixture)
mu_z <- numeric(n)
num_z <- den_z <- matrix(NA, S, n)
for(i in 1:n){
w <- exp(-log_lik_vec(theta_z) + log_lik_vec(theta_z)[,i])
w <- w / sum(w)
num_z[,i] <- lik_z[,i]*w
den_z[,i] <- w
mu_z[i] <- sum(num_z[,i])
}
rm(list = ls())
set.seed(1)
library(mcmcse)
############################################################
# 1. Data
############################################################
n <- 50
x <- rnorm(n)
y <- 1 + 2*x + rnorm(n)
sigma2 <- 1
tau2 <- 100
############################################################
# 2. Log posterior
############################################################
log_prior <- function(theta){
sum(dnorm(theta, 0, sqrt(tau2), log = TRUE))
}
log_lik_vec_single <- function(theta){
mu <- theta[1] + theta[2]*x
dnorm(y, mu, sqrt(sigma2), log = TRUE)
}
log_posterior <- function(theta){
log_prior(theta) + sum(log_lik_vec_single(theta))
}
############################################################
# 3. q_mix log-density and gradient
############################################################
log_q_mix <- function(theta){
ll <- log_lik_vec_single(theta)
log_prior(theta) + sum(ll) + log(sum(exp(-ll)))
}
grad_log_q_mix <- function(theta){
mu <- theta[1] + theta[2]*x
r <- y - mu
# gradient of sum log-likelihood
grad_ll <- c(sum(r), sum(r*x)) / sigma2
ll <- log_lik_vec_single(theta)
w <- exp(-ll) / sum(exp(-ll))
grad_lse <- -colSums(cbind(r, r*x) * w) / sigma2
grad_ll + grad_lse - theta/tau2
}
U_mix <- function(theta) -log_q_mix(theta)
grad_U_mix <- function(theta) -grad_log_q_mix(theta)
############################################################
# 4. HMC sampler (unchanged)
############################################################
leapfrog_hmc <- function(epsilon, L, niters, U, grad, x_init, M) {
d <- length(x_init)
M_inv <- chol2inv(chol(M))
x <- matrix(NA, niters, d)
x[1,] <- x_init
chol_M <- chol(M)
p <- matrix(rnorm(niters*d), niters, d) %*% chol_M
acc <- 0
for(k in 2:niters){
x_prop <- x[k-1,]
p_prop <- p[k,]
g <- grad(x_prop)
p_prop <- p_prop - 0.5*epsilon*g
for(l in 1:L){
x_prop <- x_prop + epsilon*(M_inv %*% p_prop)
g <- grad(x_prop)
if(l != L) p_prop <- p_prop - epsilon*g
}
p_prop <- p_prop - 0.5*epsilon*g
H_curr <- U(x[k-1,]) + 0.5*t(p[k,]) %*% (M_inv %*% p[k,])
H_prop <- U(x_prop) + 0.5*t(p_prop) %*% (M_inv %*% p_prop)
if(log(runif(1)) < -(H_prop - H_curr)){
x[k,] <- x_prop
acc <- acc + 1
} else {
x[k,] <- x[k-1,]
}
}
list(samples = x, acc = acc/niters)
}
############################################################
# 5. Sampling
############################################################
S <- 1e4
# Gelfand (RW–MH)
run_mh <- function(S){
theta <- matrix(NA, S, 2)
cur <- c(1,2)
lp <- log_posterior(cur)
for(s in 1:S){
prop <- cur + rnorm(2, 0, 0.1)
lp_prop <- log_posterior(prop)
if(log(runif(1)) < lp_prop - lp){
cur <- prop; lp <- lp_prop
}
theta[s,] <- cur
}
theta
}
theta_g <- run_mh(S)
# Zanella (HMC on q_mix)
theta_z <- leapfrog_hmc(
epsilon = 0.01, L = 10, niters = S,
U = U_mix, grad = grad_U_mix,
x_init = c(1,2), M = diag(2)
)$samples
############################################################
# 6. Log-likelihood matrices (FIXED)
############################################################
loglik_g <- loglik_z <- matrix(NA, S, n)
for(s in 1:S){
loglik_g[s,] <- log_lik_vec_single(theta_g[s,])
loglik_z[s,] <- log_lik_vec_single(theta_z[s,])
}
lik_g <- exp(loglik_g)
lik_z <- exp(loglik_z)
############################################################
# 7. LOOCV estimators
############################################################
# ---- Gelfand ----
mu_g <- sapply(1:n, function(i) 1/mean(1/lik_g[,i]))
elpd_g <- sum(log(mu_g))
# ---- Zanella (self-normalized mixture) ----
mu_z <- numeric(n)
num_z <- den_z <- matrix(NA, S, n)
for(i in 1:n){
w <- exp(-loglik_z[,i])
w <- w / sum(w)
num_z[,i] <- lik_z[,i] * w
den_z[,i] <- w
mu_z[i] <- sum(num_z[,i])
}
elpd_z <- sum(log(mu_z))
############################################################
# 8. MCSE (correct gradients)
############################################################
# Gelfand
num_g <- matrix(1, S, n)
den_g <- 1/lik_g
grad_g <- c(rep(1, n), -mu_g)
foo_g <- mcse.multi(cbind(num_g, den_g), r = 1)
se_g <- as.numeric(t(grad_g) %*% foo_g$cov %*% grad_g / S)
# Zanella (self-normalized)
g1 <- 1/mu_z
g2 <- rep(-1, n)
grad_z <- c(g1, g2)
foo_z <- mcse.multi(cbind(num_z, den_z), r = 1)
se_z <- as.numeric(t(grad_z) %*% foo_z$cov %*% grad_z / S)
############################################################
# 9. Output
############################################################
cat("\nGelfand ELPD:", elpd_g, " SE:", se_g, "\n")
cat("Zanella ELPD:", elpd_z, " SE:", se_z, "\n")
foo_g <- mcse.multi(cbind(num_g, den_g), r = 1, adjust = FALSE, size = 100)
se_g <- as.numeric(t(grad_g) %*% foo_g$cov %*% grad_g / S)
se_g
rm(list = ls())
set.seed(1)
