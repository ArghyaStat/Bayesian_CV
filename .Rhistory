############################################################
## LOOCV–ELPD: Gelfand, Zanella, PSIS (full pipeline)
############################################################
rm(list = ls())
set.seed(1)
library(mcmcse)
############################################################
# 1. Data
############################################################
n <- 50
x <- rnorm(n)
y <- 1 + 2*x + rnorm(n)
sigma2 <- 1
tau2 <- 100
############################################################
# 2. Prior, likelihood, posterior
############################################################
log_prior <- function(theta){
sum(dnorm(theta, 0, sqrt(tau2), log = TRUE))
}
log_like <- function(theta){
mu <- theta[1] + theta[2]*x
dnorm(y, mu, sqrt(sigma2), log = TRUE)
}
log_posterior <- function(theta){
log_prior(theta) + sum(log_like(theta))
}
############################################################
# 3. q_mix (Zanella) target and gradient
############################################################
log_q_mix <- function(theta){
ll <- log_like(theta)
log_prior(theta) + sum(ll) + log(sum(exp(-ll)))
}
grad_log_q_mix <- function(theta){
mu <- theta[1] + theta[2]*x
r <- y - mu
grad_ll <- c(sum(r), sum(r*x)) / sigma2
ll <- log_like(theta)
w <- exp(-ll) / sum(exp(-ll))
grad_lse <- -colSums(cbind(r, r*x) * w) / sigma2
grad_ll + grad_lse - theta/tau2
}
U_post <- function(theta) -log_posterior(theta)
grad_U_post <- function(theta){
mu <- theta[1] + theta[2]*x
r <- y - mu
grad_ll <- c(sum(r), sum(r*x)) / sigma2
-(grad_ll - theta/tau2)
}
U_mix <- function(theta) -log_q_mix(theta)
grad_U_mix <- function(theta) -grad_log_q_mix(theta)
############################################################
# 4. Hamiltonian Monte Carlo
############################################################
leapfrog_hmc <- function(epsilon, L, niters, U, grad, x_init, M){
d <- length(x_init)
M_inv <- chol2inv(chol(M))
x <- matrix(NA, niters, d)
x[1,] <- x_init
chol_M <- chol(M)
p <- matrix(rnorm(niters*d), niters, d) %*% chol_M
acc <- 0
for(k in 2:niters){
x_prop <- x[k-1,]
p_prop <- p[k,]
g <- grad(x_prop)
p_prop <- p_prop - 0.5*epsilon*g
for(l in 1:L){
x_prop <- x_prop + epsilon*(M_inv %*% p_prop)
g <- grad(x_prop)
if(l != L) p_prop <- p_prop - epsilon*g
}
p_prop <- p_prop - 0.5*epsilon*g
H_curr <- U(x[k-1,]) + 0.5*t(p[k,]) %*% (M_inv %*% p[k,])
H_prop <- U(x_prop) + 0.5*t(p_prop) %*% (M_inv %*% p_prop)
if(log(runif(1)) < -(H_prop - H_curr)){
x[k,] <- x_prop
acc <- acc + 1
} else {
x[k,] <- x[k-1,]
}
}
list(samples = x, acc = acc/niters)
}
############################################################
# 5. Main HMC runs
############################################################
S <- 5000
theta_g <- leapfrog_hmc(
epsilon = 0.25, L = 20, niters = S,
U = U_post, grad = grad_U_post,
x_init = c(1,2), M = diag(2)
)$samples
theta_z <- leapfrog_hmc(
epsilon = 0.24, L = 20, niters = S,
U = U_mix, grad = grad_U_mix,
x_init = c(1,2), M = diag(2)
)$samples
############################################################
# 6. Likelihood matrices
############################################################
loglik_g <- loglik_z <- matrix(NA, S, n)
for(s in 1:S){
loglik_g[s,] <- log_like(theta_g[s,])
loglik_z[s,] <- log_like(theta_z[s,])
}
lik_g <- exp(loglik_g)
lik_z <- exp(loglik_z)
############################################################
# 7. Gelfand estimator + SE
############################################################
mu_g <- sapply(1:n, function(i) 1/mean(1/lik_g[,i]))
elpd_g <- sum(log(mu_g))
num_g <- matrix(1, S, n)
den_g <- 1/lik_g
grad_g <- c(rep(1, n), -mu_g)
foo_g <- mcse.multi(cbind(num_g, den_g), r = 1)
se_g <- as.numeric(t(grad_g) %*% foo_g$cov %*% grad_g / S)
############################################################
# 8. Zanella estimator + SE
############################################################
mu_z <- numeric(n)
num_z <- den_z <- matrix(NA, S, n)
for(i in 1:n){
w <- exp(-loglik_z[,i])
w <- w / sum(w)
num_z[,i] <- lik_z[,i] * w
den_z[,i] <- w
mu_z[i] <- sum(num_z[,i])
}
elpd_z <- sum(log(mu_z))
grad_z <- c(1/colMeans(num_z), -1/colMeans(den_z))
foo_z <- mcse.multi(cbind(num_z, den_z), r = 1)
se_z <- as.numeric(t(grad_z) %*% foo_z$cov %*% grad_z / S)
############################################################
# 9. PSIS (hard-coded) + SE
############################################################
psis_smooth <- function(log_ratios, tail_frac = 0.2){
S <- length(log_ratios)
M <- ceiling(tail_frac * S)
lw <- log_ratios - max(log_ratios)
ord <- order(lw)
tail <- ord[(S-M+1):S]
y <- exp(lw[tail]) - min(exp(lw[tail]))
k <- 0.5*(mean(y)^2/var(y) - 1)
sigma <- mean(y)*(1+k)
p <- (seq_len(M)-0.5)/M
smoothed <- min(exp(lw[tail])) + (sigma/k)*((1-p)^(-k)-1)
lw[tail] <- log(smoothed)
lw <- pmin(lw, 0.5*log(S))
w <- exp(lw)
w/sum(w)
}
mu_p <- numeric(n)
num_p <- den_p <- matrix(NA, S, n)
for(i in 1:n){
w <- psis_smooth(-loglik_g[,i])
num_p[,i] <- lik_g[,i] * w
den_p[,i] <- w
mu_p[i] <- sum(num_p[,i])
}
elpd_p <- sum(log(mu_p))
grad_p <- c(1/colMeans(num_p), -1/colMeans(den_p))
foo_p <- mcse.multi(cbind(num_p, den_p), r = 1)
se_p <- as.numeric(t(grad_p) %*% foo_p$cov %*% grad_p / S)
############################################################
# 10. Replication (brute force)
############################################################
reps <- 100
elpd_rep_g <- elpd_rep_z <- elpd_rep_p <- numeric(reps)
for(r in 1:reps){
theta_g <- leapfrog_hmc(0.25,20,S,U_post,grad_U_post,c(1,2),diag(2))$samples
theta_z <- leapfrog_hmc(0.24,20,S,U_mix, grad_U_mix, c(1,2),diag(2))$samples
lik_g <- lik_z <- matrix(NA,S,n)
for(s in 1:S){
lik_g[s,] <- exp(log_like(theta_g[s,]))
lik_z[s,] <- exp(log_like(theta_z[s,]))
}
elpd_rep_g[r] <- sum(log(sapply(1:n, function(i) 1/mean(1/lik_g[,i]))))
elpd_rep_z[r] <- sum(log(colMeans(lik_z * (1/lik_z)/rowSums(1/lik_z))))
loocv_p <- sapply(1:n, function(i){
w <- psis_smooth(-log(lik_g[,i]))
sum(lik_g[,i]*w)
})
elpd_rep_p[r] <- sum(log(loocv_p))
}
############################################################
## LOOCV–ELPD: Gelfand, Zanella, PSIS (full pipeline)
############################################################
rm(list = ls())
set.seed(1)
library(mcmcse)
############################################################
# 1. Data
############################################################
n <- 50
x <- rnorm(n)
y <- 1 + 2*x + rnorm(n)
sigma2 <- 1
tau2 <- 100
############################################################
# 2. Prior, likelihood, posterior
############################################################
log_prior <- function(theta){
sum(dnorm(theta, 0, sqrt(tau2), log = TRUE))
}
log_like <- function(theta){
mu <- theta[1] + theta[2]*x
dnorm(y, mu, sqrt(sigma2), log = TRUE)
}
log_posterior <- function(theta){
log_prior(theta) + sum(log_like(theta))
}
############################################################
# 3. q_mix (Zanella) target and gradient
############################################################
log_q_mix <- function(theta){
ll <- log_like(theta)
log_prior(theta) + sum(ll) + log(sum(exp(-ll)))
}
grad_log_q_mix <- function(theta){
mu <- theta[1] + theta[2]*x
r <- y - mu
grad_ll <- c(sum(r), sum(r*x)) / sigma2
ll <- log_like(theta)
w <- exp(-ll) / sum(exp(-ll))
grad_lse <- -colSums(cbind(r, r*x) * w) / sigma2
grad_ll + grad_lse - theta/tau2
}
U_post <- function(theta) -log_posterior(theta)
grad_U_post <- function(theta){
mu <- theta[1] + theta[2]*x
r <- y - mu
grad_ll <- c(sum(r), sum(r*x)) / sigma2
-(grad_ll - theta/tau2)
}
U_mix <- function(theta) -log_q_mix(theta)
grad_U_mix <- function(theta) -grad_log_q_mix(theta)
############################################################
# 4. Hamiltonian Monte Carlo
############################################################
leapfrog_hmc <- function(epsilon, L, niters, U, grad, x_init, M){
d <- length(x_init)
M_inv <- chol2inv(chol(M))
x <- matrix(NA, niters, d)
x[1,] <- x_init
chol_M <- chol(M)
p <- matrix(rnorm(niters*d), niters, d) %*% chol_M
acc <- 0
for(k in 2:niters){
x_prop <- x[k-1,]
p_prop <- p[k,]
g <- grad(x_prop)
p_prop <- p_prop - 0.5*epsilon*g
for(l in 1:L){
x_prop <- x_prop + epsilon*(M_inv %*% p_prop)
g <- grad(x_prop)
if(l != L) p_prop <- p_prop - epsilon*g
}
p_prop <- p_prop - 0.5*epsilon*g
H_curr <- U(x[k-1,]) + 0.5*t(p[k,]) %*% (M_inv %*% p[k,])
H_prop <- U(x_prop) + 0.5*t(p_prop) %*% (M_inv %*% p_prop)
if(log(runif(1)) < -(H_prop - H_curr)){
x[k,] <- x_prop
acc <- acc + 1
} else {
x[k,] <- x[k-1,]
}
}
list(samples = x, acc = acc/niters)
}
############################################################
# 5. Main HMC runs
############################################################
S <- 1e3
theta_g <- leapfrog_hmc(
epsilon = 0.25, L = 20, niters = S,
U = U_post, grad = grad_U_post,
x_init = c(1,2), M = diag(2)
)$samples
theta_z <- leapfrog_hmc(
epsilon = 0.24, L = 20, niters = S,
U = U_mix, grad = grad_U_mix,
x_init = c(1,2), M = diag(2)
)$samples
############################################################
# 6. Likelihood matrices
############################################################
loglik_g <- loglik_z <- matrix(NA, S, n)
for(s in 1:S){
loglik_g[s,] <- log_like(theta_g[s,])
loglik_z[s,] <- log_like(theta_z[s,])
}
lik_g <- exp(loglik_g)
lik_z <- exp(loglik_z)
############################################################
# 7. Gelfand estimator + SE
############################################################
mu_g <- sapply(1:n, function(i) 1/mean(1/lik_g[,i]))
elpd_g <- sum(log(mu_g))
num_g <- matrix(1, S, n)
den_g <- 1/lik_g
grad_g <- c(rep(1, n), -mu_g)
foo_g <- mcse.multi(cbind(num_g, den_g), adjust = FALSE, r = 1)
se_g <- as.numeric(t(grad_g) %*% foo_g$cov %*% grad_g / S)
############################################################
# 8. Zanella estimator + SE
############################################################
mu_z <- numeric(n)
num_z <- den_z <- matrix(NA, S, n)
for(i in 1:n){
w <- exp(-loglik_z[,i])
w <- w / sum(w)
num_z[,i] <- lik_z[,i] * w
den_z[,i] <- w
mu_z[i] <- sum(num_z[,i])
}
elpd_z <- sum(log(mu_z))
grad_z <- c(1/colMeans(num_z), -1/colMeans(den_z))
foo_z <- mcse.multi(cbind(num_z, den_z), adjust = FALSE, r = 1)
se_z <- as.numeric(t(grad_z) %*% foo_z$cov %*% grad_z / S)
############################################################
# 9. PSIS (hard-coded) + SE
############################################################
psis_smooth <- function(log_ratios, tail_frac = 0.2){
S <- length(log_ratios)
M <- ceiling(tail_frac * S)
lw <- log_ratios - max(log_ratios)
ord <- order(lw)
tail <- ord[(S-M+1):S]
y <- exp(lw[tail]) - min(exp(lw[tail]))
k <- 0.5*(mean(y)^2/var(y) - 1)
sigma <- mean(y)*(1+k)
p <- (seq_len(M)-0.5)/M
smoothed <- min(exp(lw[tail])) + (sigma/k)*((1-p)^(-k)-1)
lw[tail] <- log(smoothed)
lw <- pmin(lw, 0.5*log(S))
w <- exp(lw)
w/sum(w)
}
mu_p <- numeric(n)
num_p <- den_p <- matrix(NA, S, n)
for(i in 1:n){
w <- psis_smooth(-loglik_g[,i])
num_p[,i] <- lik_g[,i] * w
den_p[,i] <- w
mu_p[i] <- sum(num_p[,i])
}
elpd_p <- sum(log(mu_p))
grad_p <- c(1/colMeans(num_p), -1/colMeans(den_p))
foo_p <- mcse.multi(cbind(num_p, den_p), adjust = FALSE, r = 1)
se_p <- as.numeric(t(grad_p) %*% foo_p$cov %*% grad_p / S)
############################################################
# 10. Replication (brute force)
############################################################
reps <- 50
elpd_rep_g <- elpd_rep_z <- elpd_rep_p <- numeric(reps)
for(r in 1:reps){
theta_g <- leapfrog_hmc(0.25,20,S,U_post,grad_U_post,c(1,2),diag(2))$samples
theta_z <- leapfrog_hmc(0.24,20,S,U_mix, grad_U_mix, c(1,2),diag(2))$samples
lik_g <- lik_z <- matrix(NA,S,n)
for(s in 1:S){
lik_g[s,] <- exp(log_like(theta_g[s,]))
lik_z[s,] <- exp(log_like(theta_z[s,]))
}
elpd_rep_g[r] <- sum(log(sapply(1:n, function(i) 1/mean(1/lik_g[,i]))))
elpd_rep_z[r] <- sum(log(colMeans(lik_z * (1/lik_z)/rowSums(1/lik_z))))
loocv_p <- sapply(1:n, function(i){
w <- psis_smooth(-log(lik_g[,i]))
sum(lik_g[,i]*w)
})
elpd_rep_p[r] <- sum(log(loocv_p))
}
############################################################
# 11. Save outputs
############################################################
elpd_outputs <- list(
elpd_gelfand_is = elpd_g,
se_gelfand_is = se_g,
elpd_zanella_is = elpd_z,
se_zanella_is = se_z,
elpd_psis_is = elpd_p,
se_psis_is = se_p,
elpd_gelfand_rep = elpd_rep_g,
elpd_zanella_rep = elpd_rep_z,
elpd_psis_rep = elpd_rep_p
)
save(elpd_outputs, file = "elpd_outputs.RData")
