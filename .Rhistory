rm(list = ls())
mydir <- this.path::here()
setwd(mydir)
source("loocv_functions.R")
set.seed(1)
library(mcmcse)
#  Data Simulation (Model: simple linear regression)
# True parameters theta_1 = 1, theta_2 = 2
# Data size = 50
n <- 50
x <- rnorm(n)
y <- 1 + 2*x + rnorm(n)
sigma2 <- 1
tau2 <- 100
# Gelfand sampler via HMC
# MCMC sample size S = 5e3 (user's choice)
S <- 5e3
hmc_gelfand <- leapfrog_hmc(
epsilon = 0.25,
L = 20,
niters = S,
U = U_post,
grad = grad_U_post,
x_init = c(1, 2),
M = diag(2)
)
acc_gelfand <- hmc_gelfand$acc # Optimal acc = 0.65
cat(sprintf("HMC Gelfand acceptance rate: %.4f\n", acc_gelfand))
theta_g <- hmc_gelfand$samples
# Zanella (HMC on q_mix)
hmc_zanella <- leapfrog_hmc(
epsilon = 0.24, L = 20, niters = S,
U = U_mix, grad = grad_U_mix,
x_init = c(1,2), M = diag(2)
)
acc_zanella <- hmc_zanella$acc
cat(sprintf("HMC Zanella acceptance rate: %.4f\n", acc_zanella))
theta_z <- hmc_zanella$samples
# Log-likelihood matrices (FIXED) of dimension S \times n for Gelfand and Zanella
# S = no.of MCMC samples, n = data size
loglik_g <- loglik_z <- matrix(NA, S, n)
for(s in 1:S){
loglik_g[s,] <- log_like(theta_g[s,])
loglik_z[s,] <- log_like(theta_z[s,])
}
lik_g <- exp(loglik_g)
lik_z <- exp(loglik_z)
# LOOCV estimators
# mu_hat and ELPD from Gelfand ----
mu_g <- sapply(1:n, function(i) 1/mean(1/lik_g[,i]))
elpd_g <- sum(log(mu_g))
## Important sampling SE
# Gelfand
num_g <- matrix(1, S, n)
den_g <- 1/lik_g
grad_g <- c(rep(1, n), -mu_g)
vec_g <- cbind(num_g, den_g)
foo_g <- mcse.multi(vec_g, r = 1, adjust = FALSE, size = 100)
Omega_hat_g <- foo_g$cov
se_g <- as.numeric(t(grad_g) %*% Omega_hat_g %*% grad_g / S)
# mu_hat and ELPD from Zanella (self-normalized mixture) ----
mu_z <- numeric(n)
num_z <- den_z <- matrix(NA, S, n)
for(i in 1:n){
w <- exp(-loglik_z[,i])
w <- w / sum(w)
num_z[,i] <- lik_z[,i] * w
den_z[,i] <- w
mu_z[i] <- sum(num_z[,i])/sum(w)
}
elpd_z <- sum(log(mu_z))
# Zanella (self-normalized)
g1 <- 1/colMeans(num_z)
g2 <- -1/colMeans(den_z)
grad_z <- c(g1, g2)
foo_z <- mcse.multi(cbind(num_z, den_z), r = 1, adjust = FALSE, size = 100)
Omega_hat_z <- foo_z$cov
se_z <- as.numeric(t(grad_z) %*% Omega_hat_z %*% grad_z / S)
# PSIS
mu_p <- numeric(n)
num_p <- den_p <- matrix(NA, S, n)
for(i in 1:n){
w <- psis_smooth(log_ratios = -loglik_g[,i], tail_frac = 0.2)
num_p[,i] <- lik_g[,i] * w
den_p[,i] <- w
mu_p[i] <- sum(num_p[,i])/sum(den_p[,i])
}
elpd_p <- sum(log(mu_p))
grad_p <- c(1/colMeans(num_p), -1/colMeans(den_p))
foo_p <- mcse.multi(cbind(num_p, den_p), adjust = FALSE, r = 1)
se_p <- as.numeric(t(grad_p) %*% foo_p$cov %*% grad_p / S)
reps <- 1e2
elpd_rep_g <- numeric(reps)
elpd_rep_z <- numeric(reps)
elpd_rep_p <- numeric(reps)
start_time <- Sys.time()  # Start time using Sys.time()
for (r in 1:reps) {
if(r %% (reps / 10) == 0) {
elapsed_time <- as.numeric(difftime(Sys.time(), start_time, units = "secs"))
cat(sprintf("Main Phase Progress: %.0f%%, Elapsed time: %.2f seconds\n",
100 * (r / reps), elapsed_time))
}
# Gelfand
theta_g <- leapfrog_hmc(
epsilon = 0.25,
L = 20,
niters = S,
U = U_post,
grad = grad_U_post,
x_init = c(1, 2),
M = diag(2)
)$samples
lik_g <- matrix(NA, S, n)
for (s in 1:S) {
lik_g[s, ] <- exp(log_like(theta_g[s, ]))
}
loocv_g <- numeric(n)
for (i in 1:n) {
loocv_g[i] <- 1 / mean(1 / lik_g[, i])
}
elpd_rep_g[r] <- sum(log(loocv_g))
# Zanella (q_mix via HMC)
theta_z <- leapfrog_hmc(
epsilon = 0.24, L = 20, niters = S,
U = U_mix, grad = grad_U_mix,
x_init = c(1,2), M = diag(2)
)$samples
lik_z <- matrix(NA, S, n)
for (s in 1:S) {
lik_z[s, ] <- exp(log_like(theta_z[s, ]))
}
loocv_z <- numeric(n)
for (i in 1:n) {
w <- 1 / lik_z[, i]
w <- w / sum(w)   # self-normalized mixture weights
loocv_z[i] <- sum(lik_z[, i] * w)/sum(w)
}
elpd_rep_z[r] <- sum(log(loocv_z))
loocv_p <- sapply(1:n, function(i){
w <- psis_smooth(log_ratios = -log(lik_g[,i]), tail_frac = 0.2)
sum(lik_g[,i]*w)/sum(w)
})
elpd_rep_p[r] <- sum(log(loocv_p))
}
end_time <- Sys.time()
total_elapsed_time <- difftime(end_time, start_time, units = "secs")[[1]]
elpd_outputs <- list("elpd_gelfand_is" = elpd_g,
"se_elpd_gelfand_is" = se_g,
"elpd_zanella_is" = elpd_z,
"se_elpd_zanella_is" = se_z,
"elpd_psis_is" = elpd_p,
"se_elpd_psis_is" = se_p,
"elpd_gelfand_rep" = elpd_rep_g,
"elpd_zanella_rep" = elpd_rep_z,
"elpd_psis_rep" = elpd_rep_p)
save(elpd_outputs, file = "elpd_outputs.RData")
# ---- Save Posterior Samples ----
# save(theta_g, acc_gelfand, file = "HMC_gelfand.RData")
# load("HMC_gelfand.RData")
# ---- Save Posterior Samples ----
# save(theta_z, acc_zanella, file = "HMC_Zanella.RData")
# load("HMC_Zanella.RData")
acc_g <- theta_g$acc
load(file = "elpd_outputs.RData")
View(elpd_outputs)
var(elpd_outputs$elpd_gelfand_rep)
rm(list = ls())
library(doParallel)
library(foreach)
library(mcmcse)
set.seed(123)
n <- 50
p <- 10
K <- 5
S <- 1e4
sigma2 <- 1e2
sim_data <- function(n, p){
X <- matrix(rnorm(n*p), n, p)
beta <- rnorm(p)
eta <- X %*% beta
prob <- 1/(1+exp(-eta))
y <- rbinom(n,1,prob)
list(X=X,y=y)
}
dat <- sim_data(n,p)
X <- dat$X
y <- dat$y
kappa <- sample(rep(1:K, length.out=n))
log_sum_exp <- function(x){
m <- max(x)
m + log(sum(exp(x - m)))
}
log_like <- function(theta, X, y){
eta <- X %*% theta
y*eta - log(1+exp(eta))
}
log_prior <- function(theta){
sum(dnorm(theta,0,sqrt(sigma2),log=TRUE))
}
grad_post <- function(theta){
eta <- X %*% theta
p_hat <- 1/(1+exp(-eta))
-( t(X) %*% (y - p_hat) + theta/sigma2 )
}
grad_b <- function(theta){
eta <- X %*% theta
p_hat <- 1/(1+exp(-eta))
-( (K-1)/K * t(X) %*% (y - p_hat) + theta/sigma2 )
}
grad_z <- function(theta){
eta <- X %*% theta
p_hat <- 1/(1+exp(-eta))
r <- y - p_hat
grad_ll <- t(X) %*% r
ll_vec <- log_like(theta,X,y)
fold_ll <- tapply(ll_vec, kappa, sum)
log_w <- -fold_ll
log_w <- log_w - log_sum_exp(log_w)
w <- exp(log_w)
grad_mix <- 0
for(k in 1:K){
idx <- which(kappa==k)
grad_k <- t(X[idx,,drop=FALSE]) %*% r[idx]
grad_mix <- grad_mix - w[k] * grad_k
}
-(grad_ll + grad_mix + theta/sigma2)
}
U_post <- function(theta){
-(sum(log_like(theta,X,y)) + log_prior(theta))
}
U_b <- function(theta){
ll <- sum(log_like(theta,X,y))
-( (K-1)/K * ll + log_prior(theta) )
}
U_z <- function(theta){
ll_vec <- log_like(theta,X,y)
fold_ll <- tapply(ll_vec, kappa, sum)
-( sum(ll_vec) + log_sum_exp(-fold_ll) + log_prior(theta) )
}
leapfrog_hmc <- function(epsilon, L, niters, U, grad, x_init, M) {
d <- length(x_init)
M_inv <- chol2inv(chol(M))
x <- matrix(NA, niters, d)
x[1,] <- x_init
chol_M <- chol(M)
p <- matrix(rnorm(niters*d), niters, d) %*% chol_M
acc <- 0
for(k in 2:niters){
x_prop <- x[k-1,]
p_prop <- p[k,]
g <- grad(x_prop)
p_prop <- p_prop - 0.5*epsilon*g
for(l in 1:L){
x_prop <- x_prop + epsilon*(M_inv %*% p_prop)
g <- grad(x_prop)
if(l != L) p_prop <- p_prop - epsilon*g
}
p_prop <- p_prop - 0.5*epsilon*g
H_curr <- U(x[k-1,]) + 0.5*t(p[k,]) %*% (M_inv %*% p[k,])
H_prop <- U(x_prop) + 0.5*t(p_prop) %*% (M_inv %*% p_prop)
if(log(runif(1)) < -(H_prop - H_curr)){
x[k,] <- x_prop
acc <- acc + 1
} else {
x[k,] <- x[k-1,]
}
}
list(samples = x, acc = acc/niters)
}
# fold likelihood with kappa function
compute_fold_lik <- function(lik){
sapply(1:K, function(k){
idx <- which(kappa==k)
apply(lik[,idx,drop=FALSE],1,prod)
})
}
x_init <- glm(y ~ X - 1, family="binomial")$coef
theta_g <- leapfrog_hmc(0.35,10,S,U_post,grad_post,x_init,diag(p))
theta_b <- leapfrog_hmc(0.35,10,S,U_b,grad_b,x_init,diag(p))
theta_z <- leapfrog_hmc(0.15,10,S,U_z,grad_z,x_init,diag(p))
acc_g <- theta_g$acc
acc_b <- theta_b$acc
acc_z <- theta_z$acc
samples_g <- theta_g$samples
samples_b <- theta_b$samples
samples_z <- theta_z$samples
lik_g <- t(exp(sapply(1:S, function(s) log_like(samples_g[s,],X,y))))
lik_b <- t(exp(sapply(1:S, function(s) log_like(samples_b[s,],X,y))))
lik_z <- t(exp(sapply(1:S, function(s) log_like(samples_z[s,],X,y))))
fold_lik_b <- compute_fold_lik(lik_b)
fold_lik_z <- compute_fold_lik(lik_z)
full_lik_b <- apply(lik_b,1,prod)
# Gelfand
mu_g <- numeric(n)
num_g <- matrix(1,S,n)
den_g <- 1/lik_g
for(i in 1:n){
mu_g[i] <- 1/mean(den_g[,i])
}
elpd_g <- sum(log(mu_g))
grad_g <- c(1/colMeans(num_g), -1/colMeans(den_g))
Omega_g <- mcse.multi(cbind(num_g, den_g), r=1)$cov
grad_g <- c(1/colMeans(num_g), -1/colMeans(den_g))
Omega_g <- mcse.multi(cbind(num_g, den_g), r=1,
adjust = FALSE, size = 100)$cov
se_g <- as.numeric(t(grad_g) %*% Omega_g %*% grad_g / S)
se_g
elpd_g
# Bronze
mu_b <- numeric(n)
num_b <- den_b <- matrix(NA,S,n)
for(i in 1:n){
k_i <- kappa[i]
lik_fold <- fold_lik_b[,k_i]
lik_train <- fold_lik_b[,-k_i]
# full_lik_b / lik_fold
w <- (lik_train)^(1/K) * (lik_fold)^(-(K-1)/K)
num_b[,i] <- lik_b[,i] * w
den_b[,i] <- w
mu_b[i] <- sum(num_b[,i]) / sum(den_b[,i])
}
# Bronze
mu_b <- numeric(n)
num_b <- den_b <- matrix(NA,S,n)
for(i in 1:n){
k_i <- kappa[i]
lik_fold <- fold_lik_b[,k_i]
lik_train <- fold_lik_b[,-k_i]
# full_lik_b / lik_fold
w <- (lik_train)^(1/K) * (lik_fold)^(-(K-1)/K)
num_b[,i] <- lik_b[,i] * w
den_b[,i] <- w
mu_b[i] <- sum(num_b[,i]) / sum(den_b[,i])
}
# Bronze
mu_b <- numeric(n)
num_b <- den_b <- matrix(NA,S,n)
for(i in 1:n){
k_i <- kappa[i]
lik_fold <- fold_lik_b[,k_i]
lik_train <- full_lik_b / lik_fold
w <- (lik_train)^(1/K) * (lik_fold)^(-(K-1)/K)
num_b[,i] <- lik_b[,i] * w
den_b[,i] <- w
mu_b[i] <- sum(num_b[,i]) / sum(den_b[,i])
}
elpd_b <- sum(log(mu_b))
grad_b_vec <- c(1/colMeans(num_b), -1/colMeans(den_b))
Omega_b <- mcse.multi(cbind(num_b, den_b), r=1,
adjust = FALSE, size = 100)$cov
se_b <- as.numeric(t(grad_b_vec) %*% Omega_b %*% grad_b_vec / S)
se_b
# Zanella
mu_z <- numeric(n)
num_z <- den_z <- matrix(NA,S,n)
denom_all <- rowSums(1/fold_lik_z)
for(i in 1:n){
k_i <- kappa[i]
w <- (1/fold_lik_z[,k_i]) / denom_all
num_z[,i] <- lik_z[,i] * w
den_z[,i] <- w
mu_z[i] <- sum(num_z[,i]) / sum(den_z[,i])
}
elpd_z <- sum(log(mu_z))
grad_z_vec <- c(1/colMeans(num_z), -1/colMeans(den_z))
Omega_z <- mcse.multi(cbind(num_z, den_z), r=1,
adjust = FALSE, size = 100)$cov
se_z <- as.numeric(t(grad_z_vec) %*% Omega_z %*% grad_z_vec / S)
se_z
