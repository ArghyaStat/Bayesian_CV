),
col = c(COL_M1_A, COL_M2_A, COL_SEP),
pch = c(19, 1, NA),
lty = c(1, 1, 4),
lwd = c(3.0, 3.0, 3.2),
pt.cex = c(1.6, 1.6, NA),
pt.lwd = c(NA, 2.0, NA),
bty = "o", bg = adjustcolor("white", 0.94), box.col = "grey75",
cex = 1.35, y.intersp = 1.15)
box(lwd = 1.8)
# PANEL (b): Relative Efficiency ESS / S
plot(NA, xlim = xlim_common, ylim = ylim_eff,
xlab = expression("Iterations (" * italic(S) * ")"),
ylab = expression(widehat(ESS)(italic(S)) / italic(S)),
main = "", xaxt = "n", yaxt = "n")
axis(1, at = s_ticks_uniform, labels = s_labels_uniform, gap.axis = 0)
axis(2, at = y_ticks_eff, labels = y_labels_eff)
abline(h = y_ticks_eff,     col = "grey92", lty = 1, lwd = 0.8)
abline(v = s_ticks_uniform, col = "grey92", lty = 1, lwd = 0.8)
if (!is.na(sep_S)) {
abline(v = sep_S, col = COL_SEP, lty = 4, lwd = 3.0)
}
lines(h1$S, eff_pred_m1, col = COL_M1_A, lwd = 3.0, lty = 1)
points(h1$S, eff_pred_m1, col = COL_M1_A, pch = 19, cex = 1.5)
