}
# ------------------------------------------------------------------------------
# FIGURE 3: 2-Panel Side-by-Side (a) Raw ESS & (b) Relative Efficiency ESS / S
# ------------------------------------------------------------------------------
plot_ess_side_by_side <- function() {
par(
mfrow    = c(1, 2),
mar      = c(6.5, 8.5, 2.5, 2.0),
oma      = c(0.5, 0.5, 0.5, 0.5),
mgp      = c(5.2, 1.5, 0),
cex.lab  = 2.2,
cex.axis = 1.6,
las      = 1
)
# PANEL (a): Raw ESS
plot(NA, xlim = xlim_common, ylim = ylim_ess,
xlab = expression("Iterations (" * italic(S) * ")"),
ylab = expression(widehat(ESS)(italic(S))),
main = "", xaxt = "n", yaxt = "n")
axis(1, at = s_ticks_uniform, labels = s_labels_uniform, gap.axis = 0)
axis(2, at = y_ticks_ess, labels = y_labels_ess)
abline(h = y_ticks_ess,     col = "grey92", lty = 1, lwd = 0.8)
abline(v = s_ticks_uniform, col = "grey92", lty = 1, lwd = 0.8)
if (!is.na(sep_S)) {
abline(v = sep_S, col = COL_SEP, lty = 4, lwd = 3.0)
}
lines(h1$S, h1$ess_elppd, col = COL_M1_A, lwd = 3.0, lty = 1)
points(h1$S, h1$ess_elppd, col = COL_M1_A, pch = 19, cex = 1.5)
lines(h2$S, h2$ess_elppd, col = COL_M2_A, lwd = 3.0, lty = 2)
points(h2$S, h2$ess_elppd, col = COL_M2_A, pch = 17, cex = 1.5)
legend("topleft", inset = c(0.025, 0.025),
legend = c(
expression(widehat(ESS)[elppd] ~ "(M1 Logistic)"),
expression(widehat(ESS)[elppd] ~ "(M2 Cloglog)")
),
col = c(COL_M1_A, COL_M2_A),
pch = c(19, 17),
lty = c(1, 2),
lwd = c(3.0, 3.0),
pt.cex = c(1.5, 1.5),
bty = "o", bg = adjustcolor("white", 0.94), box.col = "grey75",
cex = 1.35, y.intersp = 1.15)
box(lwd = 1.8)
# PANEL (b): Relative Efficiency ESS / S
plot(NA, xlim = xlim_common, ylim = ylim_eff,
xlab = expression("Iterations (" * italic(S) * ")"),
ylab = expression(widehat(ESS)(italic(S)) / italic(S)),
main = "", xaxt = "n", yaxt = "n")
axis(1, at = s_ticks_uniform, labels = s_labels_uniform, gap.axis = 0)
axis(2, at = y_ticks_eff, labels = y_labels_eff)
abline(h = y_ticks_eff,     col = "grey92", lty = 1, lwd = 0.8)
abline(v = s_ticks_uniform, col = "grey92", lty = 1, lwd = 0.8)
if (!is.na(sep_S)) {
abline(v = sep_S, col = COL_SEP, lty = 4, lwd = 3.0)
}
lines(h1$S, eff_pred_m1, col = COL_M1_A, lwd = 3.0, lty = 1)
points(h1$S, eff_pred_m1, col = COL_M1_A, pch = 19, cex = 1.5)
lines(h2$S, eff_pred_m2, col = COL_M2_A, lwd = 3.0, lty = 2)
points(h2$S, eff_pred_m2, col = COL_M2_A, pch = 17, cex = 1.5)
legend("topright", inset = c(0.025, 0.025),
legend = c(
expression(italic(M)[1] ~ "(Logistic):" ~ widehat(ESS)[elppd] / italic(S)),
expression(italic(M)[2] ~ "(Cloglog):" ~ widehat(ESS)[elppd] / italic(S))
),
col = c(COL_M1_A, COL_M2_A),
pch = c(19, 17),
lty = c(1, 2),
lwd = c(3.0, 3.0),
pt.cex = c(1.5, 1.5),
bty = "o", bg = adjustcolor("white", 0.94), box.col = "grey75",
cex = 1.35, y.intersp = 1.15)
box(lwd = 1.8)
}
# ------------------------------------------------------------------------------
# Export Figures
# ------------------------------------------------------------------------------
# 1. Primary Figure: ELPPD and Correctly-Scaled Raw ESS (elppd_side_by_side_separation)
pdf("elppd_side_by_side_separation.pdf", width = 16, height = 7.5)
plot_side_by_side()
dev.off()
cat("Saved publication PDF: elppd_side_by_side_separation.pdf\n")
png("elppd_side_by_side_separation.png", width = 3200, height = 1500, res = 200)
plot_side_by_side()
dev.off()
cat("Saved preview PNG: elppd_side_by_side_separation.png\n")
# 2. Figure: ELPPD and Relative Efficiency ESS / S (elppd_side_by_side_efficiency)
pdf("elppd_side_by_side_efficiency.pdf", width = 16, height = 7.5)
plot_side_by_side_efficiency()
dev.off()
cat("Saved publication PDF: elppd_side_by_side_efficiency.pdf\n")
png("elppd_side_by_side_efficiency.png", width = 3200, height = 1500, res = 200)
plot_side_by_side_efficiency()
dev.off()
cat("Saved preview PNG: elppd_side_by_side_efficiency.png\n")
# 3. Figure: Raw ESS and Relative Efficiency ESS / S Side-by-Side (ess_side_by_side)
pdf("ess_side_by_side.pdf", width = 16, height = 7.5)
plot_ess_side_by_side()
dev.off()
cat("Saved publication PDF: ess_side_by_side.pdf\n")
png("ess_side_by_side.png", width = 3200, height = 1500, res = 200)
plot_ess_side_by_side()
dev.off()
cat("Saved preview PNG: ess_side_by_side.png\n")
cat("\n=== Output Analysis Complete ===\n")
