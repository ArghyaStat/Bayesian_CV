}
cat(sprintf("Cloglog intercept calibrated to inverted prevalence %.3f: eta0 = %.4f\n",
p_bar, beta_init[1]))
# ---- Gibbs Sampling (component-wise ESS, no warm-up) ------------------------
# No adaptation is needed for ESS, so the chain starts at the Lasso solution
# and every iteration is kept. tau and c^2 start at tau0 and slab_scale^2.
cat(sprintf("Running Main Gibbs LOOCV sampling for %d iterations (component-wise ESS)...\n", S_max))
t_start <- proc.time()
fit_main <- gibbs_loocv_rhs_ess_cpp(
X          = X,
y          = y,
theta_init = beta_init,
tau0       = tau0,
slab_scale = slab_scale,
slab_df    = slab_df,
niters     = S_max,
link       = "cloglog",
n_sweeps   = n_sweeps,
interweave_tau = interweave_tau
)
t_elapsed    <- (proc.time() - t_start)[3]
evals_mix    <- fit_main$evals_per_coord
beta_samples <- fit_main$samples
cat(sprintf("Main Gibbs sampling complete in %.2f s. Likelihood evaluations per coordinate: %.2f\n", t_elapsed, evals_mix))
cat(sprintf("Distinct folds visited: %d of %d\n", length(unique(fit_main$folds)), n))
cat(sprintf("tau: median %.4f (prior scale tau0 = %.4f); c^2: median %.3f\n",
median(fit_main$tau), tau0, median(fit_main$c2)))
# ---- Vectorised Log-Likelihood Matrix (Cloglog Link) -------------------------
compute_log_lik_mat_cloglog <- function(samples, X, y) {
eta <- tcrossprod(samples, X)
y_mat <- matrix(y, nrow(samples), ncol(eta), byrow = TRUE)
# Stable log(1 - exp(-exp(eta)))
ll_y1 <- ifelse(
eta > 36, 0,
ifelse(
eta > 4, -exp(-exp(eta)),
ifelse(eta < -16, eta, log(-expm1(-exp(eta))))
)
)
ll_y0 <- -exp(pmin(eta, 50))
y_mat * ll_y1 + (1 - y_mat) * ll_y0
}
cat("Computing log-likelihood matrix (Cloglog link)...\n")
log_lik_mix <- compute_log_lik_mat_cloglog(beta_samples, X, y)
# ---- Sequential ELPPD History -----------------------------------------------
cat("Evaluating sequential ELPPD and MCSE checkpoints...\n")
history <- list(
S         = numeric(),
ess_elppd = numeric(),
minESS_xi = numeric(),
elppd_hat = numeric(),
bias      = numeric(),
mse       = numeric(),
asymp_se  = numeric()
)
for (S_curr in S_vals) {
tup <- tuple_function(log_lik_mix, kappa, S_curr)
out <- elppd.details(
tup$numerator,
tup$denominator,
elppd_true = NULL,
samples    = cbind(beta_samples[1:S_curr, , drop = FALSE],
tau = fit_main$tau[1:S_curr],
c2  = fit_main$c2[1:S_curr])
)
history$S         <- c(history$S,         S_curr)
history$ess_elppd <- c(history$ess_elppd, out$ess_elppd)
history$minESS_xi <- c(history$minESS_xi, out$minESS_xi)
history$elppd_hat <- c(history$elppd_hat, out$elppd)
history$bias      <- c(history$bias,      out$bias)
history$mse       <- c(history$mse,       out$mse)
history$asymp_se  <- c(history$asymp_se,  out$asymp_se)
}
print(data.frame(
S         = history$S,
elppd_hat = round(history$elppd_hat, 3),
asymp_se  = round(history$asymp_se, 4),
ess_elppd = round(history$ess_elppd, 1),
minESS_xi = round(history$minESS_xi, 1)
))
# ---- Save --------------------------------------------------------------------
link <- "cloglog"
save(
history,
evals_mix,
t_elapsed,
p0,
tau0,
slab_scale,
slab_df,
interweave_tau,
n,
d,
link,
file = "M2_ess_outputs.RData"
)
cat("Results saved to M2_ess_outputs.RData\n")
## ==============================================================================
## output_nonreps.R
## Bayesian Logistic vs. Cloglog Regression with Regularised Horseshoe:
## Link Misspecification Analysis on d = 207 (Storyline A: CAD vs All)
## ==============================================================================
rm(list = ls())
invisible(gc())
if (requireNamespace("this.path", quietly = TRUE)) {
setwd(this.path::here())
}
# Load non-replicated outputs
if (!file.exists("M1_outputs.RData")) stop("M1_outputs.RData not found. Please run run_M1.R first.")
if (!file.exists("M2_outputs.RData")) stop("M2_outputs.RData not found. Please run run_M2.R first.")
load("M1_outputs.RData")
nr_M1_history <- history
acc_M1        <- if (exists("acc_mix")) acc_mix else NA_real_
d_M1          <- d
n_val         <- n
link_M1       <- if (exists("link")) link else "logit"
tau0_M1       <- if (exists("tau0")) tau0 else NA_real_
p0_M1         <- if (exists("p0")) p0 else NA_real_
rm(history)
load("M2_outputs.RData")
nr_M2_history <- history
acc_M2        <- if (exists("acc_mix")) acc_mix else NA_real_
d_M2          <- d
link_M2       <- if (exists("link")) link else "cloglog"
tau0_M2       <- if (exists("tau0")) tau0 else NA_real_
p0_M2         <- if (exists("p0")) p0 else NA_real_
rm(history)
S_vals <- nr_M1_history$S
S_star <- min(S_vals)
S_max  <- max(S_vals)
S_step <- if (length(S_vals) > 1) diff(S_vals)[1] else NA_real_
n_checkpoints <- length(S_vals)
cat("==================================================================\n")
cat("Link Misspecification Analysis: Storyline A (d = 207, CAD vs All)\n")
cat("==================================================================\n")
cat(sprintf("Model M1 (%s) : d = %d (D = %d shrunk), n = %d, tau0 = %.5f (p0 = %.1f)\n",
toupper(link_M1), d_M1, d_M1 - 1, n_val, tau0_M1, p0_M1))
cat(sprintf("Model M2 (%s): d = %d (D = %d shrunk), n = %d, tau0 = %.5f (p0 = %.1f)\n",
toupper(link_M2), d_M2, d_M2 - 1, n_val, tau0_M2, p0_M2))
cat(sprintf("Final ELPPD:\n  M1 (Logit)  : %.3f (SE = %.4f, ESS = %.1f, minESS_xi = %.1f)\n  M2 (Cloglog): %.3f (SE = %.4f, ESS = %.1f, minESS_xi = %.1f)\n  Delta (M2 - M1): %+.3f\n",
tail(nr_M1_history$elppd_hat, 1), tail(nr_M1_history$asymp_se, 1),
tail(nr_M1_history$ess_elppd, 1), tail(nr_M1_history$minESS_xi, 1),
tail(nr_M2_history$elppd_hat, 1), tail(nr_M2_history$asymp_se, 1),
tail(nr_M2_history$ess_elppd, 1), tail(nr_M2_history$minESS_xi, 1),
tail(nr_M2_history$elppd_hat, 1) - tail(nr_M1_history$elppd_hat, 1)))
z_crit        <- qnorm(0.975)
ess_target05  <- 4 * z_crit^2 / (0.05^2)
ess_target025 <- 4 * z_crit^2 / (0.025^2)
h1 <- nr_M1_history
h2 <- nr_M2_history
hw1 <- z_crit * h1$asymp_se
hw2 <- z_crit * h2$asymp_se
m1_lo <- h1$elppd_hat - hw1
m1_hi <- h1$elppd_hat + hw1
m2_lo <- h2$elppd_hat - hw2
m2_hi <- h2$elppd_hat + hw2
compute_S_sep <- function(h1, h2, z_crit = qnorm(0.975)) {
hw1 <- z_crit * h1$asymp_se
hw2 <- z_crit * h2$asymp_se
m1_lo <- h1$elppd_hat - hw1
m1_hi <- h1$elppd_hat + hw1
m2_lo <- h2$elppd_hat - hw2
m2_hi <- h2$elppd_hat + hw2
is_sep <- (m1_lo > m2_hi) | (m2_lo > m1_hi)
if (length(is_sep) > 0 && is_sep[length(is_sep)]) {
fi <- which(!is_sep)
k_sep <- if (length(fi) == 0) 1L else max(fi) + 1L
return(h1$S[k_sep])
}
return(NA_real_)
}
sep_S <- compute_S_sep(h1, h2, z_crit = z_crit)
if (!is.na(sep_S)) {
cat(sprintf("Data-adaptive separation attained at S_sep = %s iterations!\n",
format(sep_S, big.mark = ",")))
k_sep <- which(h1$S == sep_S)
cat(sprintf("  At S = %s: M1 = %.2f [%.2f, %.2f] vs M2 = %.2f [%.2f, %.2f]\n\n",
format(sep_S, big.mark = ","),
h1$elppd_hat[k_sep], m1_lo[k_sep], m1_hi[k_sep],
h2$elppd_hat[k_sep], m2_lo[k_sep], m2_hi[k_sep]))
} else {
cat("No complete non-overlapping separation attained through S_max.\n\n")
}
COL_M1_A     <- "#08519C"   # Blue (M1 Logistic)
COL_M2_A     <- "#D73027"   # Red (M2 Cloglog)
COL_SEP      <- "#006837"   # Forest green
xlim_common      <- range(S_vals)
s_ticks_uniform  <- pretty(S_vals, n = 8)
s_ticks_uniform  <- s_ticks_uniform[s_ticks_uniform >= S_star & s_ticks_uniform <= S_max]
s_labels_uniform <- if (max(S_vals) >= 1e3) paste0(s_ticks_uniform / 1000, "K") else as.character(s_ticks_uniform)
elppd_min_raw <- min(c(h1$elppd_hat, h2$elppd_hat, m1_lo, m2_lo), na.rm = TRUE)
elppd_max_raw <- max(c(h1$elppd_hat, h2$elppd_hat, m1_hi, m2_hi), na.rm = TRUE)
y_range       <- elppd_max_raw - elppd_min_raw
if (y_range < 1e-5) y_range <- 1.0
y_ticks1   <- pretty(c(elppd_min_raw - 0.08 * y_range, elppd_max_raw + 0.25 * y_range), n = 7)
ylim_elppd <- range(y_ticks1)
# Data-adaptive y-axis limits and ticks for ESS:
# Scale based on the actual observed ESS values from the MCMC output (up to S_max = 10,000)
# rather than inflating to 30K from unreachable asymptotic targets
max_obs_ess  <- max(c(h1$ess_elppd, h2$ess_elppd), na.rm = TRUE)
y_ticks_ess  <- pretty(c(0, max_obs_ess * 1.15), n = 5)
ylim_ess     <- c(0, max(y_ticks_ess))
y_labels_ess <- format(y_ticks_ess, big.mark = ",")
# Relative efficiency: ESS / S
eff_pred_m1  <- h1$ess_elppd / h1$S
eff_pred_m2  <- h2$ess_elppd / h2$S
max_obs_eff  <- max(c(eff_pred_m1, eff_pred_m2), na.rm = TRUE)
y_ticks_eff  <- pretty(c(0, max_obs_eff * 1.15), n = 5)
ylim_eff     <- c(0, max(y_ticks_eff))
y_labels_eff <- sprintf("%.2f", y_ticks_eff)
# ------------------------------------------------------------------------------
# FIGURE 1: 2-Panel Side-by-Side (a) ELPPD Tracking & (b) Raw ESS Progression
# ------------------------------------------------------------------------------
plot_side_by_side <- function() {
par(
mfrow    = c(1, 2),
mar      = c(6.5, 8.5, 2.5, 2.0),
oma      = c(0.5, 0.5, 0.5, 0.5),
mgp      = c(5.2, 1.5, 0),
cex.lab  = 2.2,
cex.axis = 1.6,
las      = 1
)
# PANEL (a): ELPPD Dynamic Tracking
plot(NA, xlim = xlim_common, ylim = ylim_elppd,
xlab = expression("Iterations (" * italic(S) * ")"),
ylab = expression(widehat(ELPPD)(italic(S))),
main = "", xaxt = "n", yaxt = "n")
axis(1, at = s_ticks_uniform, labels = s_labels_uniform, gap.axis = 0)
axis(2, at = y_ticks1, labels = y_ticks1)
abline(h = y_ticks1,        col = "grey92", lty = 1, lwd = 0.8)
abline(v = s_ticks_uniform, col = "grey92", lty = 1, lwd = 0.8)
if (!is.na(sep_S)) {
abline(v = sep_S, col = COL_SEP, lty = 4, lwd = 3.2)
}
arrows(h1$S, m1_lo, h1$S, pmin(m1_hi, ylim_elppd[2]), code = 3, angle = 90, length = 0.06,
col = adjustcolor(COL_M1_A, 0.50), lwd = 2.4)
arrows(h2$S, m2_lo, h2$S, pmin(m2_hi, ylim_elppd[2]), code = 3, angle = 90, length = 0.06,
col = adjustcolor(COL_M2_A, 0.55), lwd = 2.4)
lines(h1$S,  h1$elppd_hat, col = COL_M1_A, lwd = 3.2)
points(h1$S, h1$elppd_hat, col = COL_M1_A, pch = 19, cex = 1.6)
lines(h2$S,  h2$elppd_hat, col = COL_M2_A, lwd = 3.2)
points(h2$S, h2$elppd_hat, col = COL_M2_A, pch = 1,  cex = 1.6, lwd = 2.0)
sep_legend_txt <- if (!is.na(sep_S)) {
bquote("Separation (" * italic(S)[sep] == .(format(sep_S, big.mark = ",")) * ")")
} else {
expression("No separation")
}
d_pred <- d_M1 - 1
legend("topright", inset = c(0.025, 0.025),
legend = c(
as.expression(bquote(italic(M)[1] ~ "(Logistic," ~ italic(d) == .(d_pred) * ")")),
as.expression(bquote(italic(M)[2] ~ "(Cloglog," ~ italic(d) == .(d_pred) * ")")),
sep_legend_txt
),
col = c(COL_M1_A, COL_M2_A, COL_SEP),
pch = c(19, 1, NA),
lty = c(1, 1, 4),
lwd = c(3.0, 3.0, 3.2),
pt.cex = c(1.6, 1.6, NA),
pt.lwd = c(NA, 2.0, NA),
bty = "o", bg = adjustcolor("white", 0.94), box.col = "grey75",
cex = 1.35, y.intersp = 1.15)
box(lwd = 1.8)
# PANEL (b): Raw ESS Progression (correctly scaled)
plot(NA, xlim = xlim_common, ylim = ylim_ess,
xlab = expression("Iterations (" * italic(S) * ")"),
ylab = expression(widehat(ESS)(italic(S))),
main = "", xaxt = "n", yaxt = "n")
axis(1, at = s_ticks_uniform, labels = s_labels_uniform, gap.axis = 0)
axis(2, at = y_ticks_ess, labels = y_labels_ess)
abline(h = y_ticks_ess,     col = "grey92", lty = 1, lwd = 0.8)
abline(v = s_ticks_uniform, col = "grey92", lty = 1, lwd = 0.8)
# Only plot target lines if they fall within the visible range
show_target05  <- (ess_target05 <= ylim_ess[2])
show_target025 <- (ess_target025 <= ylim_ess[2])
if (show_target05) {
abline(h = ess_target05,  col = "darkorange2", lty = 3, lwd = 2.6)
}
if (show_target025) {
abline(h = ess_target025, col = "purple3",     lty = 3, lwd = 2.6)
}
if (!is.na(sep_S)) {
abline(v = sep_S, col = COL_SEP, lty = 4, lwd = 3.0)
}
lines(h1$S, h1$ess_elppd, col = COL_M1_A, lwd = 3.0, lty = 1)
points(h1$S, h1$ess_elppd, col = COL_M1_A, pch = 19, cex = 1.5)
lines(h2$S, h2$ess_elppd, col = COL_M2_A, lwd = 3.0, lty = 2)
points(h2$S, h2$ess_elppd, col = COL_M2_A, pch = 17, cex = 1.5)
leg_text <- c(
expression(widehat(ESS)[elppd] ~ "(M1 Logistic)"),
expression(widehat(ESS)[elppd] ~ "(M2 Cloglog)")
)
leg_col <- c(COL_M1_A, COL_M2_A)
leg_pch <- c(19, 17)
leg_lty <- c(1, 2)
leg_lwd <- c(3.0, 3.0)
leg_pt_cex <- c(1.5, 1.5)
if (show_target05) {
leg_text <- c(leg_text, expression("Target (" * epsilon == 0.05 * ")"))
leg_col  <- c(leg_col, "darkorange2")
leg_pch  <- c(leg_pch, NA)
leg_lty  <- c(leg_lty, 3)
leg_lwd  <- c(leg_lwd, 2.6)
leg_pt_cex <- c(leg_pt_cex, NA)
}
if (show_target025) {
leg_text <- c(leg_text, expression("Target (" * epsilon == 0.025 * ")"))
leg_col  <- c(leg_col, "purple3")
leg_pch  <- c(leg_pch, NA)
leg_lty  <- c(leg_lty, 3)
leg_lwd  <- c(leg_lwd, 2.6)
leg_pt_cex <- c(leg_pt_cex, NA)
}
legend("topleft", inset = c(0.025, 0.025),
legend = leg_text,
col = leg_col,
pch = leg_pch,
lty = leg_lty,
lwd = leg_lwd,
pt.cex = leg_pt_cex,
bty = "o", bg = adjustcolor("white", 0.94), box.col = "grey75",
cex = 1.35, y.intersp = 1.15)
box(lwd = 1.8)
}
