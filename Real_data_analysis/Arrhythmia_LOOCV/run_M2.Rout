> # Link Misspecification Study: Model M2 (Misspecified - Cloglog Link)
> # Dataset: Arrhythmia full dataset (n = 452, d = 258: 1 intercept + 257 covariates)
> 
> rm(list = ls())
> invisible(gc())
> set.seed(4091)
> 
> library(glmnet)
Loading required package: Matrix
Loaded glmnet 4.1-10
> library(doParallel)
Loading required package: foreach
Loading required package: iterators
Loading required package: parallel
> library(mcmcse)
> library(Rcpp)
> 
> if (requireNamespace("this.path", quietly = TRUE)) {
+   setwd(this.path::here())
+ }
> 
> # Register parallel backend with up to 50 cores for glmnet
> ncores <- min(10, parallel::detectCores())
> registerDoParallel(cores = ncores)
> 
> 
> source("elppd_utils.R")
> Rcpp::sourceCpp("gibbs_loocv_ess.cpp")
> 
> # ---- Parameters --------------------------------------------------------------
> 
> n_sweeps   <- 1L   # ESS sweeps over theta_0..theta_D per Gibbs iteration
> 
> S_star   <- 5e3
> S_max    <- 2e5
> S_step   <- 5e3
> S_vals   <- seq(S_star, S_max, by = S_step)
> 
> # ---- Hyper-parameters (identical for M1 and M2) -----------------------------
> 
> p0         <- 10    # prior guess of relevant predictors (fixed, shared)
> slab_scale <- 2     # s:  slab scale
> slab_df    <- 4     # nu: slab degrees of freedom
> interweave_tau <- TRUE  # non-centred tau update
> 
> 
> # ---- Data & Model Specs ------------------------------------------------------
> 
> load("data.RData")
> 
> if (file.exists("model_specs.RData")) {
+   load("model_specs.RData")
+ }
> 
> if (exists("data_M2")) {
+   model_data <- data_M2
+   y <- 1 - data$y
+   X <- if (exists("X_M2")) X_M2 else model_data$X
+ } else {
+   y <- 1 - data$y
+   X <- data$X
+ }
> 
> n <- nrow(X)
> d <- ncol(X)
> D <- d - 1          # number of shrunk coefficients in M2 (D = 257, full model)
> kappa <- 1:n
> 
> cat(sprintf("Setting up Model M2 (Cloglog link, Full model): n = %d, d = %d \n",
+             n, d, D))
Setting up Model M2 (Cloglog link, Full model): n = 452, d = 258 
Warning message:
In sprintf("Setting up Model M2 (Cloglog link, Full model): n = %d, d = %d \n",  :
  one argument not used by format 'Setting up Model M2 (Cloglog link, Full model): n = %d, d = %d 
'
> cat(sprintf("Homeostasis cases (Y*=1, Normal Rhythm): %d (%.2f%%)\n",
+             sum(y), 100 * mean(y)))
Homeostasis cases (Y*=1, Normal Rhythm): 408 (90.27%)
> 
> # ---- Global-scale hyper-parameter ------------------------------------------
> mu_hat      <- mean(y)
> sigma_tilde <- 1 / sqrt(mu_hat * (1 - mu_hat))
> tau0        <- p0 / (D - p0) * sigma_tilde / sqrt(n)
> 
> cat(sprintf("  p0 = %.1f, sigma_tilde = %.3f, tau0 = %.5f, slab: scale = %.1f, df = %.1f\n",
+             p0, sigma_tilde, tau0, slab_scale, slab_df))
  p0 = 10.0, sigma_tilde = 3.374, tau0 = 0.00642, slab: scale = 2.0, df = 4.0
> 
> # Lasso initialization via cv.glmnet with nfolds = n, parallel = TRUE
> cat(sprintf("Computing Lasso initialization (nfolds = %d, parallel = TRUE)...\n", n))
Computing Lasso initialization (nfolds = 452, parallel = TRUE)...
> cv_fit_init <- glmnet::cv.glmnet(
+   x = X[, -1, drop = FALSE],
+   y = y,
+   family = "binomial",
+   type.measure = "deviance",
+   alpha = 1,
+   intercept = TRUE,
+   standardize = TRUE,
+   nfolds = 1e2,
+   parallel = TRUE
+ )
> beta_init <- as.numeric(coef(cv_fit_init, s = "lambda.min"))
> 
> 
> p_bar <- 1 / (1 + exp(-beta_init[1]))
> if (p_bar > 0 && p_bar < 1) {
+   beta_init[1] <- log(-log(1 - p_bar))
+ }
> cat(sprintf("Cloglog intercept calibrated to inverted prevalence %.3f: eta0 = %.4f\n",
+             p_bar, beta_init[1]))
Cloglog intercept calibrated to inverted prevalence 0.947: eta0 = 1.0755
> 
> # ---- Gibbs Sampling (component-wise ESS, no warm-up) ------------------------
> 
> cat(sprintf("Running Main Gibbs LOOCV sampling for %d iterations...\n", S_max))
Running Main Gibbs LOOCV sampling for 200000 iterations...
> t_start <- proc.time()
> fit_main <- gibbs_loocv_rhs_ess_cpp(
+   X          = X,
+   y          = y,
+   theta_init = beta_init,
+   tau0       = tau0,
+   slab_scale = slab_scale,
+   slab_df    = slab_df,
+   niters     = S_max,
+   link       = "cloglog",
+   n_sweeps   = n_sweeps,
+   interweave_tau = interweave_tau
+ )
> t_elapsed    <- (proc.time() - t_start)[3]
> evals_mix    <- fit_main$evals_per_coord
> beta_samples <- fit_main$samples
> cat(sprintf("Main Gibbs sampling complete in %.2f s. Likelihood evaluations per coordinate: %.2f\n", 
+             t_elapsed, evals_mix))
Main Gibbs sampling complete in 815.81 s. Likelihood evaluations per coordinate: 1.17
> cat(sprintf("Distinct folds visited: %d of %d\n", length(unique(fit_main$folds)), n))
Distinct folds visited: 452 of 452
