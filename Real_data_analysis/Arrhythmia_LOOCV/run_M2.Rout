+             median(fit_main$tau), tau0, median(fit_main$c2)))
tau: median 0.0063 (prior scale tau0 = 0.0064); c^2: median 4.584
> 
> # ---- Vectorised Log-Likelihood Matrix (Cloglog Link) -------------------------
> 
> compute_log_lik_mat_cloglog <- function(samples, X, y) {
+   eta <- tcrossprod(samples, X)
+   y_mat <- matrix(y, nrow(samples), ncol(eta), byrow = TRUE)
+   
+   # Stable log(1 - exp(-exp(eta)))
+   ll_y1 <- ifelse(
+     eta > 36, 0,
+     ifelse(
+       eta > 4, -exp(-exp(eta)),
+       ifelse(eta < -16, eta, log(-expm1(-exp(eta))))
+     )
+   )
+   ll_y0 <- -exp(pmin(eta, 50))
+   
+   y_mat * ll_y1 + (1 - y_mat) * ll_y0
+ }
> 
> cat("Computing log-likelihood matrix (Cloglog link)...\n")
Computing log-likelihood matrix (Cloglog link)...
> log_lik_mix <- compute_log_lik_mat_cloglog(beta_samples, X, y)
> 
> # ---- Sequential ELPPD History -----------------------------------------------
> 
> cat("Evaluating sequential ELPPD and MCSE checkpoints...\n")
Evaluating sequential ELPPD and MCSE checkpoints...
> history <- list(
+   S         = numeric(),
+   ess_elppd = numeric(),
+   minESS_xi = numeric(),
+   elppd_hat = numeric(),
+   bias      = numeric(),
+   mse       = numeric(),
+   asymp_se  = numeric()
+ )
> 
> for (S_curr in S_vals) {
+   tup <- tuple_function(log_lik_mix, kappa, S_curr)
+   out <- elppd.details(
+     tup$numerator,
+     tup$denominator,
+     elppd_true = NULL,
+     samples    = cbind(beta_samples[1:S_curr, , drop = FALSE],
+                        tau = fit_main$tau[1:S_curr],
+                        c2  = fit_main$c2[1:S_curr])
+   )
+   history$S         <- c(history$S,         S_curr)
+   history$ess_elppd <- c(history$ess_elppd, out$ess_elppd)
+   history$minESS_xi <- c(history$minESS_xi, out$minESS_xi)
+   history$elppd_hat <- c(history$elppd_hat, out$elppd)
+   history$bias      <- c(history$bias,      out$bias)
+   history$mse       <- c(history$mse,       out$mse)
+   history$asymp_se  <- c(history$asymp_se,  out$asymp_se)
+ }
> 
