install.packages("loo")
rm(list = ls())
mydir <- this.path::here()
setwd(mydir)
library(MASS)
library(doParallel)
library(foreach)
library(loo)
source("proposals.R")
source("sampler.R")
source("elppd_utils.R")
n <- 50
d <- 10
K <- 5
S <- 1e4
# Hyperparameters
sigma2 <- 1
tau2 <- 1e2
set.seed(1709)
sim_data <- function(n, d){
X <- matrix(rnorm(n*d), n, d)
beta_true <- rnorm(d)
y <- X %*% beta_true + rnorm(n, sd = sqrt(sigma2))
list(X = X,
y = as.vector(y),
beta_true = beta_true)
}
dat <- sim_data(n, d)
X <- dat$X
y <- dat$y
log_like <- function(theta, X, y){
mu <- X %*% theta
dnorm(y,
mean = mu,
sd = sqrt(sigma2),
log = TRUE)
}
grad_log_like <- function(theta, X, y){
mu <- X %*% theta
r <- y - mu
X * as.vector(r) / sigma2
}
log_prior <- function(theta){
sum(dnorm(theta,
mean = 0,
sd = sqrt(tau2),
log = TRUE))
}
grad_log_prior <- function(theta){
-theta / tau2
}
cl <- makeCluster(n.cores)
fold_id <- sample(rep(seq_len(K), length.out = n))
folds <- split(seq_len(n), fold_id)
fold_sizes <- lengths(folds)
kappa <- integer(n)
for(k in seq_len(K)){
kappa[folds[[k]]] <- k
}
reps <- 100
n.cores <- 50
fold_id <- sample(rep(seq_len(K), length.out = n))
folds <- split(seq_len(n), fold_id)
fold_sizes <- lengths(folds)
kappa <- integer(n)
for(k in seq_len(K)){
kappa[folds[[k]]] <- k
}
alpha_fold <- (n - fold_sizes) / n
# Scalar Bronze power
alpha <- mean(alpha_fold)
# Initial value
x_init <- lm(y ~ X - 1)$coef
fit_g <- leapfrog_hmc(
epsilon = 0.16,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = x_init,
M = diag(d),
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
fit_b <- leapfrog_hmc(
epsilon = 0.16,
L = 10,
niters = S,
U = U_b,
grad_U = grad_b,
