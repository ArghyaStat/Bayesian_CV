results$var_b_tis,
results$var_b_psis,
results$var_z_is,
results$var_z_tis,
results$var_z_psis,
# include sample variances
var(results$elppd_g_is),
var(results$elppd_g_tis),
var(results$elppd_g_psis),
var(results$elppd_b_is),
var(results$elppd_b_tis),
var(results$elppd_b_psis),
var(results$elppd_z_is),
var(results$elppd_z_tis),
var(results$elppd_z_psis))
}
# ---------------------------------------------------------
# First pass: compute common y-axis limits
# ---------------------------------------------------------
all.var.estimator <- c()
all.var.asymp <- c()
S_mcmc <- S
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
vars_est <- extract_var_estimator(results)
all.var.estimator <- c(all.var.estimator, vars_est)
all.var.asymp <- c(all.var.asymp, S_mcmc * vars_est)
}
min_val_est <- min(all.var.estimator[all.var.estimator > 0], na.rm = TRUE)
max_val_est <- max(all.var.estimator, na.rm = TRUE)
common.var.estimator.ylim <- c(min_val_est, max_val_est)
min_val_asymp <- min(all.var.asymp[all.var.asymp > 0], na.rm = TRUE)
max_val_asymp <- max(all.var.asymp, na.rm = TRUE)
common.var.asymp.ylim <- c(min_val_asymp, max_val_asymp)
# ---------------------------------------------------------
# 1. Estimator Variance comparison plot
# ---------------------------------------------------------
pdf("Gaussian_k_fold_variance_estimator_comparison.pdf",
width = pdf_width,
height = pdf_height)
par(mfrow = c(rows, cols),
mar = c(6,4,3,1),
mgp = c(2,0.7,0),
tcl = -0.3)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
plot_var_panel_estimator(results = results,
title = paste0("K = ", K),
ylim = common.var.estimator.ylim)
}
dev.off()
# ---------------------------------------------------------
# 2. Asymptotic Variance comparison plot
# ---------------------------------------------------------
pdf("Gaussian_k_fold_variance_comparison.pdf",
width = pdf_width,
height = pdf_height)
par(mfrow = c(rows, cols),
mar = c(6,4,3,1),
mgp = c(2,0.7,0),
tcl = -0.3)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
plot_var_panel_asymp(results = results,
title = paste0("K = ", K),
S_mcmc = S_mcmc,
ylim = common.var.asymp.ylim)
}
dev.off()
rm(list = ls())
mydir <- this.path::here()
setwd(mydir)
library(MASS)
library(foreach)
library(doParallel)
library(loo)
source("proposals.R")
source("sampler.R")
source("elppd_utils.R")
# Specifications
K <- 20
S <- 1e4
# Load simulated data (generated by Gaussian_simulation.R)
load("Gaussian_data.RData")
n <- nrow(X)
d <- ncol(X)
sigma2 <- 1
tau2 <- 1e2
# Fold construction
set.seed(2026) # Different seed for fold generation
kappa <- sample(rep(seq_len(K),
length.out = n))
folds <- split(seq_len(n), kappa)
# size of each fold
fold_sizes <- lengths(folds)
# Fold-specific powers alpha_k
alpha_fold <- (n - fold_sizes) / n
alpha <- 1 - mean(fold_sizes) / n
# Gaussian likelihood
log_like <- function(theta, X, y){
mu <- X %*% theta
dnorm(y,
mean = mu,
sd = sqrt(sigma2),
log = TRUE)
}
# Gradient log-likelihood
grad_log_like <- function(theta, X, y){
mu <- X %*% theta
r <- y - mu
X * as.vector(r) / sigma2
}
# Gaussian prior
log_prior <- function(theta){
sum(dnorm(theta,
mean = 0,
sd = sqrt(tau2),
log = TRUE))
}
# Gradient prior
grad_log_prior <- function(theta){
-theta / tau2
}
# Initial value
theta_init <- lm(y ~ X - 1)$coef
# Gelfand sampler
fit_g <- leapfrog_hmc(
epsilon = 0.12,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = theta_init,
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
fit_g$acc
# Bronze sampler
fit_b <- leapfrog_hmc(
epsilon = 0.115,
L = 10,
niters = S,
U = U_b,
grad_U = grad_b,
x_init = theta_init,
X = X,
y = y,
alpha = alpha,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior
)
fit_b$acc
# Zanella sampler
fit_z <- leapfrog_hmc(
epsilon = 0.12,
L = 10,
niters = S,
U = U_z,
grad_U = grad_z,
x_init = theta_init,
X = X,
y = y,
kappa = kappa,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior
)
fit_z$acc
samples_g <- fit_g$samples
samples_b <- fit_b$samples
samples_z <- fit_z$samples
# Log-likelihood matrices of dimension S \times n
log_lik_g <- t(sapply(1:S, function(s)
log_like(samples_g[s, ], X, y)))
log_lik_b <- t(sapply(1:S, function(s)
log_like(samples_b[s, ], X, y)))
log_lik_z <- t(sapply(1:S, function(s)
log_like(samples_z[s, ], X, y)))
# Gelfand
tup_g_is <- tuple_function(
log_lik_mat = log_lik_g,
kappa = kappa,
method = "Gelfand",
weight_type = "is"
)
tup_g_tis <- tuple_function(
log_lik_mat = log_lik_g,
kappa = kappa,
method = "Gelfand",
weight_type = "tis"
)
tup_g_psis <- tuple_function(
log_lik_mat = log_lik_g,
kappa = kappa,
method = "Gelfand",
weight_type = "psis"
)
# Bronze
tup_b_is <- tuple_function(
log_lik_mat = log_lik_b,
kappa = kappa,
method = "Bronze",
weight_type = "is",
alpha = alpha
)
tup_b_tis <- tuple_function(
log_lik_mat = log_lik_b,
kappa = kappa,
method = "Bronze",
weight_type = "tis",
alpha = alpha
)
tup_b_psis <- tuple_function(
log_lik_mat = log_lik_b,
kappa = kappa,
method = "Bronze",
weight_type = "psis",
alpha = alpha
)
# Zanella
tup_z_is <- tuple_function(
log_lik_mat = log_lik_z,
kappa = kappa,
method = "Zanella",
weight_type = "is"
)
tup_z_tis <- tuple_function(
log_lik_mat = log_lik_z,
kappa = kappa,
method = "Zanella",
weight_type = "tis"
)
tup_z_psis <- tuple_function(
log_lik_mat = log_lik_z,
kappa = kappa,
method = "Zanella",
weight_type = "psis"
)
# Asymptotic SE estimation
# Gelfand outputs
out_g_is <- elppd.details(num = tup_g_is$numerator,
den = tup_g_is$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_g_tis <- elppd.details(num = tup_g_tis$numerator,
den = tup_g_tis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_g_psis <- elppd.details(num = tup_g_psis$numerator,
den = tup_g_psis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
# Bronze outputs
out_b_is <- elppd.details(num = tup_b_is$numerator,
den = tup_b_is$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_b_tis <- elppd.details(num = tup_b_tis$numerator,
den = tup_b_tis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_b_psis <- elppd.details(num = tup_b_psis$numerator,
den = tup_b_psis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
# Zanella outputs
out_z_is <- elppd.details(num = tup_z_is$numerator,
den = tup_z_is$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_z_tis <- elppd.details(num = tup_z_tis$numerator,
den = tup_z_tis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_z_psis <- elppd.details(num = tup_z_psis$numerator,
den = tup_z_psis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out <-
c(exact_elppd  = exact_elppd,
elppd_g_is   = out_g_is$elppd,
var_g_is     = out_g_is$asymp_se,
elppd_g_tis  = out_g_tis$elppd,
var_g_tis    = out_g_tis$asymp_se,
elppd_g_psis = out_g_psis$elppd,
var_g_psis   = out_g_psis$asymp_se,
acc_g = fit_g$acc,
elppd_b_is   = out_b_is$elppd,
var_b_is     = out_b_is$asymp_se,
elppd_b_tis  = out_b_tis$elppd,
var_b_tis    = out_b_tis$asymp_se,
elppd_b_psis = out_b_psis$elppd,
var_b_psis   = out_b_psis$asymp_se,
acc_b = fit_b$acc,
elppd_z_is   = out_z_is$elppd,
var_z_is     = out_z_is$asymp_se,
elppd_z_tis  = out_z_tis$elppd,
var_z_tis    = out_z_tis$asymp_se,
elppd_z_psis = out_z_psis$elppd,
var_z_psis   = out_z_psis$asymp_se,
acc_z = fit_z$acc
)
var_at_S_scale <- S*(c(out["var_g_is"], out["var_g_tis"], out["var_g_psis"],
out["var_b_is"], out["var_b_tis"], out["var_b_psis"],
out["var_z_is"], out["var_z_tis"], out["var_z_psis"]))
print(var_at_S_scale)
rm(list = ls())
mydir <- this.path::here()
setwd(mydir)
# Fold construction
set.seed(2026)
library(MASS)
library(foreach)
library(doParallel)
library(loo)
source("proposals.R")
source("sampler.R")
source("elppd_utils.R")
# Specifications
K.vec <- c(5, 10, 20, 50, 100)
S <- 1e5
reps <- 1e2
n.cores <- 50
# Load simulated data (generated by logistic_simulation.R)
load("logistic_data.RData")
n <- nrow(X)
d <- ncol(X)
tau2 <- 1e2
log_like <- function(theta, X, y){
eta <- as.vector(X %*% theta)
loss <- pmax(eta, 0) + log1p(exp(-abs(eta)))
y * eta - loss
}
grad_log_like <- function(theta, X, y){
eta <- as.vector(X %*% theta)
p <- plogis(eta)
X * as.vector(y - p)
}
log_prior <- function(theta){
sum(dnorm(theta,
mean = 0,
sd = sqrt(tau2),
log = TRUE))
}
grad_log_prior <- function(theta){
-theta / tau2
}
# Initial value
theta_init <- glm(y ~ X - 1, family = binomial)$coef
K = 5
kappa <- sample(rep(seq_len(K),
length.out = n))
folds <- split(seq_len(n), kappa)
# size of each fold
fold_sizes <- lengths(folds)
# Fold-specific powers alpha_k
alpha_fold <- (n - fold_sizes) / n
alpha <- 1 - mean(fold_sizes) / n
alpha
fit_g <- leapfrog_hmc(
epsilon = 0.35,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = theta_init,
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
fit_g$acc
