plot_var_panel <- function(
results,
title){
#---------------------------------------------------------
# Estimated asymptotic variances
#---------------------------------------------------------
plot.data <- list(
results$var_g_is,
results$var_g_tis,
results$var_g_psis,
results$var_b_is,
results$var_b_tis,
results$var_b_psis,
results$var_z_is,
results$var_z_tis,
results$var_z_psis
)
#---------------------------------------------------------
# Sample variances
#---------------------------------------------------------
samp.var <- c(
var(results$elppd_g_is),
var(results$elppd_g_tis),
var(results$elppd_g_psis),
var(results$elppd_b_is),
var(results$elppd_b_tis),
var(results$elppd_b_psis),
var(results$elppd_z_is),
var(results$elppd_z_tis),
var(results$elppd_z_psis)
)
ymax <- max(
unlist(plot.data),
samp.var
)
pos <- 1:9
boxplot(
plot.data,
at = pos,
names = rep(
c("IS", "TIS", "PSIS"),
3
),
col = box.cols,
border = "black",
ylim = c(0, ymax),
las = 2,
outline = FALSE,
xaxt = "n",
ylab = "Variance",
main = title
)
axis(
1,
at = pos,
labels = rep(
c("IS", "TIS", "PSIS"),
3
),
las = 2
)
axis(
1,
at = c(2, 5, 8),
labels = c(
"Gelfand",
"Bronze",
"Zanella"
),
tick = FALSE,
line = 3
)
# sample variance benchmark
segments(
pos - 0.25,
samp.var,
pos + 0.25,
samp.var,
lwd = 3,
col = "red"
)
legend(
"topright",
legend = c(
"IS",
"TIS",
"PSIS",
"Sample Variance"
),
fill = c(
submethod.cols,
NA
),
border = c(
"black",
"black",
"black",
NA
),
lwd = c(
NA,
NA,
NA,
3
),
col = c(
NA,
NA,
NA,
"red"
),
bty = "n",
cex = 0.9
)
}
