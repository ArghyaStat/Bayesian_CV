}
loocv_z <- numeric(n)
for (i in 1:n) {
w <- 1 / lik_z[, i]
w <- w / sum(w)   # self-normalized mixture weights
loocv_z[i] <- sum(lik_z[, i] * w)/sum(w)
}
elpd_rep_z[r] <- sum(log(loocv_z))
loocv_p <- sapply(1:n, function(i){
w <- psis_smooth(log_ratios = -log(lik_g[,i]), tail_frac = 0.2)
sum(lik_g[,i]*w)/sum(w)
})
elpd_rep_p[r] <- sum(log(loocv_p))
}
end_time <- Sys.time()
total_elapsed_time <- difftime(end_time, start_time, units = "secs")[[1]]
elpd_outputs <- list("elpd_gelfand_is" = elpd_g,
"se_elpd_gelfand_is" = se_g,
"elpd_zanella_is" = elpd_z,
"se_elpd_zanella_is" = se_z,
"elpd_psis_is" = elpd_p,
"se_elpd_psis_is" = se_p,
"elpd_gelfand_rep" = elpd_rep_g,
"elpd_zanella_rep" = elpd_rep_z,
"elpd_psis_rep" = elpd_rep_p)
save(elpd_outputs, file = "elpd_outputs.RData")
# ---- Save Posterior Samples ----
# save(theta_g, acc_gelfand, file = "HMC_gelfand.RData")
# load("HMC_gelfand.RData")
# ---- Save Posterior Samples ----
# save(theta_z, acc_zanella, file = "HMC_Zanella.RData")
# load("HMC_Zanella.RData")
acc_g <- theta_g$acc
load(file = "elpd_outputs.RData")
View(elpd_outputs)
var(elpd_outputs$elpd_gelfand_rep)
rm(list = ls())
library(doParallel)
library(foreach)
library(mcmcse)
set.seed(123)
n <- 50
p <- 10
K <- 5
S <- 1e4
sigma2 <- 1e2
sim_data <- function(n, p){
X <- matrix(rnorm(n*p), n, p)
beta <- rnorm(p)
eta <- X %*% beta
prob <- 1/(1+exp(-eta))
y <- rbinom(n,1,prob)
list(X=X,y=y)
}
dat <- sim_data(n,p)
X <- dat$X
y <- dat$y
kappa <- sample(rep(1:K, length.out=n))
log_sum_exp <- function(x){
m <- max(x)
m + log(sum(exp(x - m)))
}
log_like <- function(theta, X, y){
eta <- X %*% theta
y*eta - log(1+exp(eta))
}
log_prior <- function(theta){
sum(dnorm(theta,0,sqrt(sigma2),log=TRUE))
}
grad_post <- function(theta){
eta <- X %*% theta
p_hat <- 1/(1+exp(-eta))
-( t(X) %*% (y - p_hat) + theta/sigma2 )
}
grad_b <- function(theta){
eta <- X %*% theta
p_hat <- 1/(1+exp(-eta))
-( (K-1)/K * t(X) %*% (y - p_hat) + theta/sigma2 )
}
grad_z <- function(theta){
eta <- X %*% theta
p_hat <- 1/(1+exp(-eta))
r <- y - p_hat
grad_ll <- t(X) %*% r
ll_vec <- log_like(theta,X,y)
fold_ll <- tapply(ll_vec, kappa, sum)
log_w <- -fold_ll
log_w <- log_w - log_sum_exp(log_w)
w <- exp(log_w)
grad_mix <- 0
for(k in 1:K){
idx <- which(kappa==k)
grad_k <- t(X[idx,,drop=FALSE]) %*% r[idx]
grad_mix <- grad_mix - w[k] * grad_k
}
-(grad_ll + grad_mix + theta/sigma2)
}
U_post <- function(theta){
-(sum(log_like(theta,X,y)) + log_prior(theta))
}
U_b <- function(theta){
ll <- sum(log_like(theta,X,y))
-( (K-1)/K * ll + log_prior(theta) )
}
U_z <- function(theta){
ll_vec <- log_like(theta,X,y)
fold_ll <- tapply(ll_vec, kappa, sum)
-( sum(ll_vec) + log_sum_exp(-fold_ll) + log_prior(theta) )
}
leapfrog_hmc <- function(epsilon, L, niters, U, grad, x_init, M) {
d <- length(x_init)
M_inv <- chol2inv(chol(M))
x <- matrix(NA, niters, d)
x[1,] <- x_init
chol_M <- chol(M)
p <- matrix(rnorm(niters*d), niters, d) %*% chol_M
acc <- 0
for(k in 2:niters){
x_prop <- x[k-1,]
p_prop <- p[k,]
g <- grad(x_prop)
p_prop <- p_prop - 0.5*epsilon*g
for(l in 1:L){
x_prop <- x_prop + epsilon*(M_inv %*% p_prop)
g <- grad(x_prop)
if(l != L) p_prop <- p_prop - epsilon*g
}
p_prop <- p_prop - 0.5*epsilon*g
H_curr <- U(x[k-1,]) + 0.5*t(p[k,]) %*% (M_inv %*% p[k,])
H_prop <- U(x_prop) + 0.5*t(p_prop) %*% (M_inv %*% p_prop)
if(log(runif(1)) < -(H_prop - H_curr)){
x[k,] <- x_prop
acc <- acc + 1
} else {
x[k,] <- x[k-1,]
}
}
list(samples = x, acc = acc/niters)
}
# fold likelihood with kappa function
compute_fold_lik <- function(lik){
sapply(1:K, function(k){
idx <- which(kappa==k)
apply(lik[,idx,drop=FALSE],1,prod)
})
}
x_init <- glm(y ~ X - 1, family="binomial")$coef
theta_g <- leapfrog_hmc(0.35,10,S,U_post,grad_post,x_init,diag(p))
theta_b <- leapfrog_hmc(0.35,10,S,U_b,grad_b,x_init,diag(p))
theta_z <- leapfrog_hmc(0.15,10,S,U_z,grad_z,x_init,diag(p))
acc_g <- theta_g$acc
acc_b <- theta_b$acc
acc_z <- theta_z$acc
samples_g <- theta_g$samples
samples_b <- theta_b$samples
samples_z <- theta_z$samples
lik_g <- t(exp(sapply(1:S, function(s) log_like(samples_g[s,],X,y))))
lik_b <- t(exp(sapply(1:S, function(s) log_like(samples_b[s,],X,y))))
lik_z <- t(exp(sapply(1:S, function(s) log_like(samples_z[s,],X,y))))
fold_lik_b <- compute_fold_lik(lik_b)
fold_lik_z <- compute_fold_lik(lik_z)
full_lik_b <- apply(lik_b,1,prod)
# Gelfand
mu_g <- numeric(n)
num_g <- matrix(1,S,n)
den_g <- 1/lik_g
for(i in 1:n){
mu_g[i] <- 1/mean(den_g[,i])
}
elpd_g <- sum(log(mu_g))
grad_g <- c(1/colMeans(num_g), -1/colMeans(den_g))
Omega_g <- mcse.multi(cbind(num_g, den_g), r=1)$cov
grad_g <- c(1/colMeans(num_g), -1/colMeans(den_g))
Omega_g <- mcse.multi(cbind(num_g, den_g), r=1,
adjust = FALSE, size = 100)$cov
se_g <- as.numeric(t(grad_g) %*% Omega_g %*% grad_g / S)
se_g
elpd_g
# Bronze
mu_b <- numeric(n)
num_b <- den_b <- matrix(NA,S,n)
for(i in 1:n){
k_i <- kappa[i]
lik_fold <- fold_lik_b[,k_i]
lik_train <- fold_lik_b[,-k_i]
# full_lik_b / lik_fold
w <- (lik_train)^(1/K) * (lik_fold)^(-(K-1)/K)
num_b[,i] <- lik_b[,i] * w
den_b[,i] <- w
mu_b[i] <- sum(num_b[,i]) / sum(den_b[,i])
}
# Bronze
mu_b <- numeric(n)
num_b <- den_b <- matrix(NA,S,n)
for(i in 1:n){
k_i <- kappa[i]
lik_fold <- fold_lik_b[,k_i]
lik_train <- fold_lik_b[,-k_i]
# full_lik_b / lik_fold
w <- (lik_train)^(1/K) * (lik_fold)^(-(K-1)/K)
num_b[,i] <- lik_b[,i] * w
den_b[,i] <- w
mu_b[i] <- sum(num_b[,i]) / sum(den_b[,i])
}
# Bronze
mu_b <- numeric(n)
num_b <- den_b <- matrix(NA,S,n)
for(i in 1:n){
k_i <- kappa[i]
lik_fold <- fold_lik_b[,k_i]
lik_train <- full_lik_b / lik_fold
w <- (lik_train)^(1/K) * (lik_fold)^(-(K-1)/K)
num_b[,i] <- lik_b[,i] * w
den_b[,i] <- w
mu_b[i] <- sum(num_b[,i]) / sum(den_b[,i])
}
elpd_b <- sum(log(mu_b))
grad_b_vec <- c(1/colMeans(num_b), -1/colMeans(den_b))
Omega_b <- mcse.multi(cbind(num_b, den_b), r=1,
adjust = FALSE, size = 100)$cov
se_b <- as.numeric(t(grad_b_vec) %*% Omega_b %*% grad_b_vec / S)
se_b
# Zanella
mu_z <- numeric(n)
num_z <- den_z <- matrix(NA,S,n)
denom_all <- rowSums(1/fold_lik_z)
for(i in 1:n){
k_i <- kappa[i]
w <- (1/fold_lik_z[,k_i]) / denom_all
num_z[,i] <- lik_z[,i] * w
den_z[,i] <- w
mu_z[i] <- sum(num_z[,i]) / sum(den_z[,i])
}
elpd_z <- sum(log(mu_z))
grad_z_vec <- c(1/colMeans(num_z), -1/colMeans(den_z))
Omega_z <- mcse.multi(cbind(num_z, den_z), r=1,
adjust = FALSE, size = 100)$cov
se_z <- as.numeric(t(grad_z_vec) %*% Omega_z %*% grad_z_vec / S)
se_z
rm(list = ls())
mydir <- this.path::here()
setwd(mydir)
library(MASS)
library(doParallel)
library(foreach)
source("proposals.R")
source("sampler.R")
source("elppd_utils.R")
# Simulation design
n <- 50
p <- 10
K <- 5
S <- 1e3
# Hyperparameters
sigma2 <- 1
tau2 <- 1e2
set.seed(1709)
# Simulate Gaussian linear model
sim_data <- function(n, p){
X <- matrix(rnorm(n*p), n, p)
beta_true <- rnorm(p)
y <- X %*% beta_true + rnorm(n, sd = sqrt(sigma2))
list(X = X,
y = as.vector(y),
beta_true = beta_true)
}
dat <- sim_data(n, p)
X <- dat$X
y <- dat$y
reps <- 100
n.cores <- 5
# Gaussian likelihood
log_like <- function(theta, X, y){
mu <- X %*% theta
dnorm(y,
mean = mu,
sd = sqrt(sigma2),
log = TRUE)
}
# Gradient log-likelihood
grad_log_like <- function(theta, X, y){
mu <- X %*% theta
r <- y - mu
X * as.vector(r) / sigma2
}
# Gaussian prior
log_prior <- function(theta){
sum(dnorm(theta,
mean = 0,
sd = sqrt(tau2),
log = TRUE))
}
# Gradient prior
grad_log_prior <- function(theta){
-theta / tau2
}
# Parallel for each loop
cl <- makeCluster(n.cores)
registerDoParallel(cl)
# Main simulation loop
results <- foreach(r = 1:reps,
.combine = rbind) %dopar% {
# Fold construction
fold_id <- sample(rep(seq_len(K), length.out = n))
folds <- split(seq_len(n), fold_id)
fold_sizes <- lengths(folds)
# Fold allocation map kappa(i)
kappa <- integer(n)
for(k in seq_len(K)){
kappa[folds[[k]]] <- k
}
# Fold-specific powers alpha_k
alpha_fold <- (n - fold_sizes) / n
# Scalar Bronze power
alpha <- mean(alpha_fold)
# Initial value
x_init <- lm(y ~ X - 1)$coef
# Gelfand sampler
fit_g <- leapfrog_hmc(
epsilon = 0.16,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = x_init,
M = diag(p),
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
# Bronze sampler
fit_b <- leapfrog_hmc(
epsilon = 0.16,
L = 10,
niters = S,
U = U_b,
grad_U = grad_b,
x_init = x_init,
M = diag(p),
X = X,
y = y,
alpha = alpha,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior
)
# Zanella sampler
fit_z <- leapfrog_hmc(
epsilon = 0.15,
L = 10,
niters = S,
U = U_z,
grad_U = grad_z,
x_init = x_init,
M = diag(p),
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
samples_g <- fit_g$samples
samples_b <- fit_b$samples
samples_z <- fit_z$samples
# Log-likelihood matrices of dimension S \times n
log_lik_g <- t(sapply(1:S, function(s)
log_like(samples_g[s, ], X, y)))
log_lik_b <- t(sapply(1:S, function(s)
log_like(samples_b[s, ], X, y)))
log_lik_z <- t(sapply(1:S, function(s)
log_like(samples_z[s, ], X, y)))
# =========================================================
# Gelfand
# =========================================================
tup_g_is <- tuple_function(
log_lik_mat = log_lik_g,
method = "Gelfand",
weight_type = "is"
)
tup_g_tis <- tuple_function(
log_lik_mat = log_lik_g,
method = "Gelfand",
weight_type = "tis"
)
tup_g_psis <- tuple_function(
log_lik_mat = log_lik_g,
method = "Gelfand",
weight_type = "psis"
)
# Bronze
tup_b_is <- tuple_function(
log_lik_mat = log_lik_b,
method = "Bronze",
weight_type = "is",
alpha = alpha
)
tup_b_tis <- tuple_function(
log_lik_mat = log_lik_b,
method = "Bronze",
weight_type = "tis",
alpha = alpha
)
tup_b_psis <- tuple_function(
log_lik_mat = log_lik_b,
method = "Bronze",
weight_type = "psis",
alpha = alpha
)
# Zanella
tup_z_is <- tuple_function(
log_lik_mat = log_lik_z,
method = "Zanella",
weight_type = "is"
)
tup_z_tis <- tuple_function(
log_lik_mat = log_lik_z,
method = "Zanella",
weight_type = "tis"
)
tup_z_psis <- tuple_function(
log_lik_mat = log_lik_z,
method = "Zanella",
weight_type = "psis"
)
# Asymptotic variance estimation
# =========================================================
out_g_is <- asymp.var.elppd(
num = tup_g_is$numerator,
den = tup_g_is$denominator,
S = S
)
out_g_tis <- asymp.var.elppd(
num = tup_g_tis$numerator,
den = tup_g_tis$denominator,
S = S
)
out_g_psis <- asymp.var.elppd(
num = tup_g_psis$numerator,
den = tup_g_psis$denominator,
S = S
)
out_b_is <- asymp.var.elppd(
num = tup_b_is$numerator,
den = tup_b_is$denominator,
S = S
)
out_b_tis <- asymp.var.elppd(
num = tup_b_tis$numerator,
den = tup_b_tis$denominator,
S = S
)
out_b_psis <- asymp.var.elppd(
num = tup_b_psis$numerator,
den = tup_b_psis$denominator,
S = S
)
out_z_is <- asymp.var.elppd(
num = tup_z_is$numerator,
den = tup_z_is$denominator,
S = S
)
out_z_tis <- asymp.var.elppd(
num = tup_z_tis$numerator,
den = tup_z_tis$denominator,
S = S
)
out_z_psis <- asymp.var.elppd(
num = tup_z_psis$numerator,
den = tup_z_psis$denominator,
S = S
)
c(
# -------------------------------------------------------
# Gelfand
# -------------------------------------------------------
elppd_g_is   = out_g_is$elppd,
var_g_is     = out_g_is$asymp_var,
elppd_g_tis  = out_g_tis$elppd,
var_g_tis    = out_g_tis$asymp_var,
elppd_g_psis = out_g_psis$elppd,
var_g_psis   = out_g_psis$asymp_var,
acc_g = fit_g$acc,
# -------------------------------------------------------
# Bronze
# -------------------------------------------------------
elppd_b_is   = out_b_is$elppd,
var_b_is     = out_b_is$asymp_var,
elppd_b_tis  = out_b_tis$elppd,
var_b_tis    = out_b_tis$asymp_var,
elppd_b_psis = out_b_psis$elppd,
var_b_psis   = out_b_psis$asymp_var,
acc_b = fit_b$acc,
# -------------------------------------------------------
# Zanella
# -------------------------------------------------------
elppd_z_is   = out_z_is$elppd,
var_z_is     = out_z_is$asymp_var,
elppd_z_tis  = out_z_tis$elppd,
var_z_tis    = out_z_tis$asymp_var,
elppd_z_psis = out_z_psis$elppd,
var_z_psis   = out_z_psis$asymp_var,
acc_z = fit_z$acc
)
}
stopCluster(cl)
results <- as.data.frame(results)
save(results,file = paste0(K,
"_fold_elppd_results_all.RData"))
View(results)
