results$var_b_is,
results$var_b_tis,
results$var_b_psis,
results$var_z_is,
results$var_z_tis,
results$var_z_psis,
# sample variances on asymptotic scale
S * var(results$elppd_g_is),
S * var(results$elppd_g_tis),
S * var(results$elppd_g_psis),
S * var(results$elppd_b_is),
S * var(results$elppd_b_tis),
S * var(results$elppd_b_psis),
S * var(results$elppd_z_is),
S * var(results$elppd_z_tis),
S * var(results$elppd_z_psis))
}
all.var <- c()
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
S <- length(results$elppd_g_is)
all.var <- c(all.var,
extract_var(results, S))
}
common.var.ylim <- c(
0,
max(all.var, na.rm = TRUE)
)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
S <- length(results$elppd_g_is)
plot_var_panel(results = results,
