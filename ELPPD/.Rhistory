library(MASS)
library(foreach)
library(doParallel)
library(loo)
source("proposals.R")
source("sampler.R")
source("elppd_utils.R")
# Simulation design
n <- 50
d <- 10
K <- 50
S <- 1e5
# Hyperparameters
sigma2 <- 1
tau2 <- 1e2
set.seed(1709)
# Simulate Gaussian linear model
sim_data <- function(n, d){
X <- matrix(rnorm(n*d), n, d)
beta_true <- rnorm(d)
y <- X %*% beta_true + rnorm(n, sd = sqrt(sigma2))
list(X = X,
y = as.vector(y),
beta_true = beta_true)
}
dat <- sim_data(n, d)
X <- dat$X
y <- dat$y
reps <- 100
n.cores <- 50
# Gaussian likelihood
log_like <- function(theta, X, y){
mu <- X %*% theta
dnorm(y,
mean = mu,
sd = sqrt(sigma2),
log = TRUE)
}
# Gradient log-likelihood
grad_log_like <- function(theta, X, y){
mu <- X %*% theta
r <- y - mu
X * as.vector(r) / sigma2
}
# Gaussian prior
log_prior <- function(theta){
sum(dnorm(theta,
mean = 0,
sd = sqrt(tau2),
log = TRUE))
}
# Gradient prior
grad_log_prior <- function(theta){
-theta / tau2
}
kappa <- sample(rep(seq_len(K),
length.out = n))
kappa
