plot_var_panel <- function(results,
title,
S,
ylim = NULL){
plot.data <- list(
results$var_g_is,
results$var_g_tis,
results$var_g_psis,
results$var_b_is,
results$var_b_tis,
results$var_b_psis,
results$var_z_is,
results$var_z_tis,
results$var_z_psis
)
# Sample variances on asymptotic variance scale
samp.var <- S * c(
var(results$elppd_g_is),
var(results$elppd_g_tis),
var(results$elppd_g_psis),
var(results$elppd_b_is),
var(results$elppd_b_tis),
var(results$elppd_b_psis),
var(results$elppd_z_is),
var(results$elppd_z_tis),
var(results$elppd_z_psis)
)
pos <- 1:9
boxplot(plot.data,
col = box.cols,
border = "black",
las = 2,
outline = FALSE,
xaxt = "n",
ylim = ylim,
ylab = expression(S %*% Variance),
main = title)
axis(1,
at = 1:9,
labels = rep(c("IS", "TIS", "PSIS"), 3),
las = 2)
axis(1,
at = c(2, 5, 8),
labels = c("Gelfand", "Bronze", "Zanella"),
tick = FALSE,
line = 3)
# Sample variance benchmark
segments(pos - 0.25,
samp.var,
pos + 0.25,
samp.var,
lwd = 2,
col = "red")
legend("topright",
legend = c("IS asymp.var",
"TIS asymp.var",
"PSIS asymp.var",
"Sample var × S"),
fill = c(submethod.cols, NA),
border = c("black", "black", "black", NA),
lty = c(NA, NA, NA, 2),
lwd = c(NA, NA, NA, 2),
col = c(NA, NA, NA, "red"),
bty = "n",
cex = 0.9)
}
