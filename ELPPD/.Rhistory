sqrt(results$var_b_tis),
sqrt(results$var_b_psis),
sqrt(results$var_z_is),
sqrt(results$var_z_tis),
sqrt(results$var_z_psis)
)
# Sample standard deviations of the estimators
samp.se <- c(
sd(results$elppd_g_is),
sd(results$elppd_g_tis),
sd(results$elppd_g_psis),
sd(results$elppd_b_is),
sd(results$elppd_b_tis),
sd(results$elppd_b_psis),
sd(results$elppd_z_is),
sd(results$elppd_z_tis),
sd(results$elppd_z_psis)
)
pos <- 1:9
boxplot(plot.data,
col = box.cols,
border = "black",
las = 2,
outline = FALSE,
xaxt = "n",
ylim = ylim,
log = "y",
ylab = "Standard Error (log-scale)",
xlab = "Method",
main = title)
axis(1,
at = 1:9,
labels = rep(c("IS", "TIS", "PSIS"), 3),
las = 2)
axis(1,
at = c(2, 5, 8),
labels = c("Gelfand", "Bronze", "Zanella"),
tick = FALSE,
line = 3)
# Sample standard deviation benchmark
segments(pos - 0.25,
samp.se,
pos + 0.25,
samp.se,
lwd = 2,
col = "red")
legend("topright",
legend = c("IS est.se",
"TIS est.se",
"PSIS est.se",
"Sample SD"),
fill = c(submethod.cols, NA),
border = c("black", "black", "black", NA),
lty = c(NA, NA, NA, 1),
lwd = c(NA, NA, NA, 2),
col = c(NA, NA, NA, "red"),
bty = "n",
cex = 0.9)
}
extract_se_estimator <- function(results){
c(sqrt(results$var_g_is),
sqrt(results$var_g_tis),
sqrt(results$var_g_psis),
sqrt(results$var_b_is),
sqrt(results$var_b_tis),
sqrt(results$var_b_psis),
sqrt(results$var_z_is),
sqrt(results$var_z_tis),
sqrt(results$var_z_psis),
# include sample standard deviations
sd(results$elppd_g_is),
sd(results$elppd_g_tis),
sd(results$elppd_g_psis),
sd(results$elppd_b_is),
sd(results$elppd_b_tis),
sd(results$elppd_b_psis),
sd(results$elppd_z_is),
sd(results$elppd_z_tis),
sd(results$elppd_z_psis))
}
all.se.estimator <- c()
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
all.se.estimator <- c(all.se.estimator, extract_se_estimator(results))
}
min_val_se <- min(all.se.estimator[all.se.estimator > 0], na.rm = TRUE)
max_val_se <- max(all.se.estimator, na.rm = TRUE)
common.se.ylim <- c(min_val_se, max_val_se)
pdf("se.pdf", width = pdf_width, height = pdf_height)
par(mfrow = c(rows, cols),
mar = c(6, 4, 3, 1),
mgp = c(2, 0.7, 0),
tcl = -0.3)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
plot_se_panel(results = results,
title = paste0("K = ", K),
ylim = common.se.ylim)
}
dev.off()
# 3. Asymptotic Variance comparison plot
plot_var_panel_asymp <- function(results,
title,
S_mcmc = S,
ylim = NULL){
# Scale estimated variances by S_mcmc to put them on the asymptotic scale (sigma2_ELPPD)
plot.data <- list(
S_mcmc * results$var_g_is,
S_mcmc * results$var_g_tis,
S_mcmc * results$var_g_psis,
S_mcmc * results$var_b_is,
S_mcmc * results$var_b_tis,
S_mcmc * results$var_b_psis,
S_mcmc * results$var_z_is,
S_mcmc * results$var_z_tis,
S_mcmc * results$var_z_psis
)
# Sample variances on asymptotic scale
samp.var <- S_mcmc * c(
var(results$elppd_g_is),
var(results$elppd_g_tis),
var(results$elppd_g_psis),
var(results$elppd_b_is),
var(results$elppd_b_tis),
var(results$elppd_b_psis),
var(results$elppd_z_is),
var(results$elppd_z_tis),
var(results$elppd_z_psis)
)
pos <- 1:9
boxplot(plot.data,
col = box.cols,
border = "black",
las = 2,
outline = FALSE,
xaxt = "n",
ylim = ylim,
log = "y",
ylab = expression(S %*% Variance ~ (log - scale)),
main = title)
axis(1,
at = 1:9,
labels = rep(c("IS", "TIS", "PSIS"), 3),
las = 2)
axis(1,
at = c(2, 5, 8),
labels = c("Gelfand",
"Bronze",
"Zanella"),
tick = FALSE,
line = 3)
# Sample variance benchmark
segments(pos - 0.25,
samp.var,
pos + 0.25,
samp.var,
lwd = 2,
col = "red")
legend("topright",
legend = c("IS asymp.var",
"TIS asymp.var",
"PSIS asymp.var",
"Sample var * S"),
fill = c(box.cols[c(1,2,3)], NA),
border = c("black",
"black",
"black",
NA),
lty = c(NA,
NA,
NA,
1),
lwd = c(NA,
NA,
NA,
2),
col = c(NA,
NA,
NA,
"red"),
bty = "n",
cex = 0.9)
}
# ---------------------------------------------------------
# Helper function to extract variance values (Estimator Scale)
# ---------------------------------------------------------
extract_var_estimator <- function(results){
c(results$var_g_is,
results$var_g_tis,
results$var_g_psis,
results$var_b_is,
results$var_b_tis,
results$var_b_psis,
results$var_z_is,
results$var_z_tis,
results$var_z_psis,
# include sample variances
var(results$elppd_g_is),
var(results$elppd_g_tis),
var(results$elppd_g_psis),
var(results$elppd_b_is),
var(results$elppd_b_tis),
var(results$elppd_b_psis),
var(results$elppd_z_is),
var(results$elppd_z_tis),
var(results$elppd_z_psis))
}
# ---------------------------------------------------------
# First pass: compute common y-axis limits
# ---------------------------------------------------------
all.var.estimator <- c()
all.var.asymp <- c()
S_mcmc <- S
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
vars_est <- extract_var_estimator(results)
all.var.estimator <- c(all.var.estimator, vars_est)
all.var.asymp <- c(all.var.asymp, S_mcmc * vars_est)
}
min_val_est <- min(all.var.estimator[all.var.estimator > 0], na.rm = TRUE)
max_val_est <- max(all.var.estimator, na.rm = TRUE)
common.var.estimator.ylim <- c(min_val_est, max_val_est)
min_val_asymp <- min(all.var.asymp[all.var.asymp > 0], na.rm = TRUE)
max_val_asymp <- max(all.var.asymp, na.rm = TRUE)
common.var.asymp.ylim <- c(min_val_asymp, max_val_asymp)
# ---------------------------------------------------------
# 1. Estimator Variance comparison plot
# ---------------------------------------------------------
pdf("Gaussian_k_fold_variance_estimator_comparison.pdf",
width = pdf_width,
height = pdf_height)
par(mfrow = c(rows, cols),
mar = c(6,4,3,1),
mgp = c(2,0.7,0),
tcl = -0.3)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
plot_var_panel_estimator(results = results,
title = paste0("K = ", K),
ylim = common.var.estimator.ylim)
}
dev.off()
# ---------------------------------------------------------
# 2. Asymptotic Variance comparison plot
# ---------------------------------------------------------
pdf("Gaussian_k_fold_variance_comparison.pdf",
width = pdf_width,
height = pdf_height)
par(mfrow = c(rows, cols),
mar = c(6,4,3,1),
mgp = c(2,0.7,0),
tcl = -0.3)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
plot_var_panel_asymp(results = results,
title = paste0("K = ", K),
S_mcmc = S_mcmc,
ylim = common.var.asymp.ylim)
}
dev.off()
rm(list = ls())
mydir <- this.path::here()
setwd(mydir)
library(MASS)
library(foreach)
library(doParallel)
library(loo)
source("proposals.R")
source("sampler.R")
source("elppd_utils.R")
# Specifications
K <- 20
S <- 1e4
# Load simulated data (generated by Gaussian_simulation.R)
load("Gaussian_data.RData")
n <- nrow(X)
d <- ncol(X)
sigma2 <- 1
tau2 <- 1e2
# Fold construction
set.seed(2026) # Different seed for fold generation
kappa <- sample(rep(seq_len(K),
length.out = n))
folds <- split(seq_len(n), kappa)
# size of each fold
fold_sizes <- lengths(folds)
# Fold-specific powers alpha_k
alpha_fold <- (n - fold_sizes) / n
alpha <- 1 - mean(fold_sizes) / n
# Gaussian likelihood
log_like <- function(theta, X, y){
mu <- X %*% theta
dnorm(y,
mean = mu,
sd = sqrt(sigma2),
log = TRUE)
}
# Gradient log-likelihood
grad_log_like <- function(theta, X, y){
mu <- X %*% theta
r <- y - mu
X * as.vector(r) / sigma2
}
# Gaussian prior
log_prior <- function(theta){
sum(dnorm(theta,
mean = 0,
sd = sqrt(tau2),
log = TRUE))
}
# Gradient prior
grad_log_prior <- function(theta){
-theta / tau2
}
# Initial value
theta_init <- lm(y ~ X - 1)$coef
# Gelfand sampler
fit_g <- leapfrog_hmc(
epsilon = 0.12,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = theta_init,
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
fit_g$acc
# Bronze sampler
fit_b <- leapfrog_hmc(
epsilon = 0.115,
L = 10,
niters = S,
U = U_b,
grad_U = grad_b,
x_init = theta_init,
X = X,
y = y,
alpha = alpha,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior
)
fit_b$acc
# Zanella sampler
fit_z <- leapfrog_hmc(
epsilon = 0.12,
L = 10,
niters = S,
U = U_z,
grad_U = grad_z,
x_init = theta_init,
X = X,
y = y,
kappa = kappa,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior
)
fit_z$acc
samples_g <- fit_g$samples
samples_b <- fit_b$samples
samples_z <- fit_z$samples
# Log-likelihood matrices of dimension S \times n
log_lik_g <- t(sapply(1:S, function(s)
log_like(samples_g[s, ], X, y)))
log_lik_b <- t(sapply(1:S, function(s)
log_like(samples_b[s, ], X, y)))
log_lik_z <- t(sapply(1:S, function(s)
log_like(samples_z[s, ], X, y)))
# Gelfand
tup_g_is <- tuple_function(
log_lik_mat = log_lik_g,
kappa = kappa,
method = "Gelfand",
weight_type = "is"
)
tup_g_tis <- tuple_function(
log_lik_mat = log_lik_g,
kappa = kappa,
method = "Gelfand",
weight_type = "tis"
)
tup_g_psis <- tuple_function(
log_lik_mat = log_lik_g,
kappa = kappa,
method = "Gelfand",
weight_type = "psis"
)
# Bronze
tup_b_is <- tuple_function(
log_lik_mat = log_lik_b,
kappa = kappa,
method = "Bronze",
weight_type = "is",
alpha = alpha
)
tup_b_tis <- tuple_function(
log_lik_mat = log_lik_b,
kappa = kappa,
method = "Bronze",
weight_type = "tis",
alpha = alpha
)
tup_b_psis <- tuple_function(
log_lik_mat = log_lik_b,
kappa = kappa,
method = "Bronze",
weight_type = "psis",
alpha = alpha
)
# Zanella
tup_z_is <- tuple_function(
log_lik_mat = log_lik_z,
kappa = kappa,
method = "Zanella",
weight_type = "is"
)
tup_z_tis <- tuple_function(
log_lik_mat = log_lik_z,
kappa = kappa,
method = "Zanella",
weight_type = "tis"
)
tup_z_psis <- tuple_function(
log_lik_mat = log_lik_z,
kappa = kappa,
method = "Zanella",
weight_type = "psis"
)
# Asymptotic SE estimation
# Gelfand outputs
out_g_is <- elppd.details(num = tup_g_is$numerator,
den = tup_g_is$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_g_tis <- elppd.details(num = tup_g_tis$numerator,
den = tup_g_tis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_g_psis <- elppd.details(num = tup_g_psis$numerator,
den = tup_g_psis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
# Bronze outputs
out_b_is <- elppd.details(num = tup_b_is$numerator,
den = tup_b_is$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_b_tis <- elppd.details(num = tup_b_tis$numerator,
den = tup_b_tis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_b_psis <- elppd.details(num = tup_b_psis$numerator,
den = tup_b_psis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
# Zanella outputs
out_z_is <- elppd.details(num = tup_z_is$numerator,
den = tup_z_is$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_z_tis <- elppd.details(num = tup_z_tis$numerator,
den = tup_z_tis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out_z_psis <- elppd.details(num = tup_z_psis$numerator,
den = tup_z_psis$denominator,
S = NULL,
b = NULL,
method = "mcmcse")
out <-
c(exact_elppd  = exact_elppd,
elppd_g_is   = out_g_is$elppd,
var_g_is     = out_g_is$asymp_se,
elppd_g_tis  = out_g_tis$elppd,
var_g_tis    = out_g_tis$asymp_se,
elppd_g_psis = out_g_psis$elppd,
var_g_psis   = out_g_psis$asymp_se,
acc_g = fit_g$acc,
elppd_b_is   = out_b_is$elppd,
var_b_is     = out_b_is$asymp_se,
elppd_b_tis  = out_b_tis$elppd,
var_b_tis    = out_b_tis$asymp_se,
elppd_b_psis = out_b_psis$elppd,
var_b_psis   = out_b_psis$asymp_se,
acc_b = fit_b$acc,
elppd_z_is   = out_z_is$elppd,
var_z_is     = out_z_is$asymp_se,
elppd_z_tis  = out_z_tis$elppd,
var_z_tis    = out_z_tis$asymp_se,
elppd_z_psis = out_z_psis$elppd,
var_z_psis   = out_z_psis$asymp_se,
acc_z = fit_z$acc
)
var_at_S_scale <- S*(c(out["var_g_is"], out["var_g_tis"], out["var_g_psis"],
out["var_b_is"], out["var_b_tis"], out["var_b_psis"],
out["var_z_is"], out["var_z_tis"], out["var_z_psis"]))
print(var_at_S_scale)
