mydir <- this.path::here()
setwd(mydir)
library(MASS)
library(foreach)
library(doParallel)
library(loo)
source("proposals.R")
source("sampler.R")
source("elppd_utils.R")
# Simulation design
n <- 1e2
d <- 10
K <- 1e2
S <- 1e4
# Hyperparameters
sigma2 <- 1
tau2 <- 1e2
set.seed(1709)
# Simulate Gaussian linear model
sim_data <- function(n, d){
X <- matrix(rnorm(n*d), n, d)
beta_true <- rnorm(d)
y <- X %*% beta_true + rnorm(n, sd = sqrt(sigma2))
list(X = X,
y = as.vector(y),
beta_true = beta_true)
}
dat <- sim_data(n, d)
X <- dat$X
y <- dat$y
# Fold construction
kappa <- sample(rep(seq_len(K),
length.out = n))
folds <- split(seq_len(n), kappa)
# size of each fold
fold_sizes <- lengths(folds)
# Fold-specific powers alpha_k
alpha_fold <- (n - fold_sizes) / n
alpha <- 1 - mean(fold_sizes) / n
reps <- 100
n.cores <- 50
# Gaussian likelihood
log_like <- function(theta, X, y){
mu <- X %*% theta
dnorm(y,
mean = mu,
sd = sqrt(sigma2),
log = TRUE)
}
# Gradient log-likelihood
grad_log_like <- function(theta, X, y){
mu <- X %*% theta
r <- y - mu
X * as.vector(r) / sigma2
}
# Gaussian prior
log_prior <- function(theta){
sum(dnorm(theta,
mean = 0,
sd = sqrt(tau2),
log = TRUE))
}
# Gradient prior
grad_log_prior <- function(theta){
-theta / tau2
}
# Initial value
theta_init <- lm(y ~ X - 1)$coef
# Gelfand sampler
fit_g <- leapfrog_hmc(
epsilon = 5e-2,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = theta_init,
M = diag(d),
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
fit_g$acc
fit_g <- leapfrog_hmc(
epsilon = 8e-2,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = theta_init,
M = diag(d),
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
fit_g$acc
fit_g <- leapfrog_hmc(
epsilon = 0.1,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = theta_init,
M = diag(d),
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
fit_g$acc
fit_g <- leapfrog_hmc(
epsilon = 0.12,
L = 10,
niters = S,
U = U_g,
grad_U = grad_g,
x_init = theta_init,
M = diag(d),
X = X,
y = y,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior)
fit_g$acc
fit_b <- leapfrog_hmc(
epsilon = 0.12,
L = 10,
niters = S,
U = U_b,
grad_U = grad_b,
x_init = theta_init,
M = diag(d),
X = X,
y = y,
alpha = alpha,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior
)
fit_b$acc
fit_z <- leapfrog_hmc(
epsilon = 0.12,
L = 10,
niters = S,
U = U_z,
grad_U = grad_z,
x_init = theta_init,
M = diag(d),
X = X,
y = y,
kappa = kappa,
log_like = log_like,
log_prior = log_prior,
grad_log_like = grad_log_like,
grad_log_prior = grad_log_prior
)
fit_z$acc
