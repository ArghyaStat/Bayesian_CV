rm(list = ls())
mydir <- this.path::here()
setwd(mydir)
# User inputs
n <- 50
d <- 10
sigma2 <- 1
tau2 <- 1e2
set.seed(1709)
# Simulate Gaussian linear model
sim_data <- function(n, d){
X <- matrix(rnorm(n*d), n, d)
beta_true <- rnorm(d)
y <- X %*% beta_true + rnorm(n, sd = sqrt(sigma2))
list(X = X,
y = as.vector(y),
beta_true = beta_true)
}
dat <- sim_data(n, d)
X <- dat$X
y <- dat$y
# Exact tractable LOO-ELPPD
exact_elpd_gaussian <- function(
X,
y,
sigma2,
tau2){
n <- nrow(X)
d <- ncol(X)
log_ppds <- numeric(n)
for(i in 1:n){
# Leave-one-out data
X_loo <- X[-i, , drop = FALSE]
y_loo <- y[-i]
x_test <- matrix(X[i, ], nrow = 1)
y_test <- y[i]
# Exact Gaussian posterior of beta | y_-i
V_post <- solve(crossprod(X_loo) / sigma2 + diag(1 / tau2, d))
m_post <- V_post %*% crossprod(X_loo, y_loo) / sigma2
# Exact posterior predictive mean and variance
pred_mean <- as.numeric(x_test %*% m_post)
pred_var <- as.numeric(sigma2 + x_test %*% V_post %*% t(x_test))
# Exact log ppd
log_ppds[i] <- dnorm(x = y_test,
mean = pred_mean,
sd = sqrt(pred_var),
log = TRUE)
}
sum(log_ppds)
}
# Exact ELPPD
elppd_exact <- exact_elpd_gaussian(X = X,
y = y,
sigma2 = sigma2,
tau2 = tau2)
elppd_exact
# Fold settings
K.vec <- c(5, 10, 50)
# Colors
submethod.cols <- c("steelblue",   # IS
"darkorange",  # TIS
"forestgreen"  # PSIS
)
box.cols <- rep(submethod.cols, 3)
# Function to plot one ELPPD panel
plot_elpd_panel <- function(results,
true_elpd,
title,
ylim = NULL){
plot.data <- list(
results$elppd_g_is,
results$elppd_g_tis,
results$elppd_g_psis,
results$elppd_b_is,
results$elppd_b_tis,
results$elppd_b_psis,
results$elppd_z_is,
results$elppd_z_tis,
results$elppd_z_psis
)
boxplot(plot.data,
col = box.cols,
border = "black",
las = 2,
outline = FALSE,
xaxt = "n",
ylim = ylim,
ylab = "ELPPD",
main = title)
axis(1,
at = 1:9,
labels = rep(c("IS", "TIS", "PSIS"), 3),
las = 2)
axis(1,
at = c(2, 5, 8),
labels = c("Gelfand", "Bronze", "Zanella"),
tick = FALSE,
line = 3)
abline(h = true_elpd,
col = "red",
lwd = 2,
lty = 2)
legend("bottomright",
legend = c("IS", "TIS", "PSIS", "Gold ELPPD"),
fill = c(submethod.cols, NA),
border = c("black", "black", "black", NA),
lty = c(NA, NA, NA, 2),
lwd = c(NA, NA, NA, 2),
col = c(NA, NA, NA, "red"),
bty = "n",
cex = 0.9)
}
# Helper function to extract ELPPD values
extract_elppd <- function(results){
c(results$elppd_g_is,
results$elppd_g_tis,
results$elppd_g_psis,
results$elppd_b_is,
results$elppd_b_tis,
results$elppd_b_psis,
results$elppd_z_is,
results$elppd_z_tis,
results$elppd_z_psis)
}
# ---------------------------------------------------------
# First pass: compute common y-axis limits
# ---------------------------------------------------------
all.elppd <- c()
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
all.elppd <- c(all.elppd,
extract_elppd(results),
elppd_exact)
}
common.ylim <- range(all.elppd, na.rm = TRUE)
common.ylim
# R script to create a LaTeX table of the variance results
if (requireNamespace("this.path", quietly = TRUE)) {
setwd(this.path::here())
}
K.vec <- c(5, 10, 50)
S_mcmc <- 5e5
methods_labels <- c(
g_is = "Gelfand IS",
g_tis = "Gelfand TIS",
g_psis = "Gelfand PSIS",
b_is = "Bronze IS",
b_tis = "Bronze TIS",
b_psis = "Bronze PSIS",
z_is = "Zanella IS",
z_tis = "Zanella TIS",
z_psis = "Zanella PSIS"
)
# Start LaTeX code
latex_code <- c(
"\\begin{table}[ht]",
"\\centering",
"\\caption{Comparison of Sample Variance and Estimated Variance (on the Asymptotic Scale $S \\times \\text{Variance}$) of the $K$-fold ELPPD Estimator. All variance values are scaled by the MCMC sample size $S = 500,000$.}",
"\\label{tab:elppd_variance_comparison}",
"\\begin{tabular}{llcccc}",
"\\hline",
"$K$ & Method & Sample Variance ($S \\times \\text{Var}(\\widehat{\\text{ELPPD}})$) & Median Est. Variance ($S \\times \\widehat{\\text{Var}}_{\\text{est}}$) & 95\\% CI of Est. Variance ($S \\times \\widehat{\\text{Var}}_{\\text{est}}$) & Ratio (Sample / Est) \\\\",
"\\hline"
)
for(K in K.vec){
load(paste0(K, "_fold_elppd_Gaussian.RData"))
first_in_block <- TRUE
for(m in names(methods_labels)){
var_col <- paste0("var_", m)
elppd_col <- paste0("elppd_", m)
# Scale by S_mcmc to put on asymptotic scale
est_vars <- results[[var_col]] * S_mcmc
samp_var <- var(results[[elppd_col]]) * S_mcmc
median_est <- median(est_vars)
ci_est <- quantile(est_vars, probs = c(0.025, 0.975))
ratio <- samp_var / median_est
k_label <- if(first_in_block) paste(K) else ""
first_in_block <- FALSE
# Format numbers cleanly
fmt <- function(x) {
if(is.na(x)) return("NA")
if(x > 1e4 || x < 1e-2) {
# format with standard LaTeX scientific notation
s <- formatC(x, format = "e", digits = 2)
parts <- strsplit(s, "e")[[1]]
exp_val <- as.numeric(parts[2])
paste0(parts[1], " \\times 10^{", exp_val, "}")
} else {
formatC(x, format = "f", digits = 2)
}
}
ci_str <- paste0("[", fmt(ci_est[1]), ", ", fmt(ci_est[2]), "]")
row_str <- paste(
k_label, "&",
methods_labels[m], "&",
fmt(samp_var), "&",
fmt(median_est), "&",
ci_str, "&",
formatC(ratio, format = "f", digits = 2),
"\\\\"
)
latex_code <- c(latex_code, row_str)
}
latex_code <- c(latex_code, "\\hline")
}
latex_code <- c(
latex_code,
"\\end{tabular}",
"\\end{table}"
)
# Write to file
writeLines(latex_code, "variance_comparison_table.tex")
# Print to console
cat(paste(latex_code, collapse = "\n"), "\n")
# R script to create a LaTeX table of the variance results
if (requireNamespace("this.path", quietly = TRUE)) {
setwd(this.path::here())
}
if (requireNamespace("this.path", quietly = TRUE)) {
setwd(this.path::here())
}
# Configuration
K.vec <- c(5, 10, 50)
S_mcmc <- 5e5 # MCMC Sample size (iterations)
# Methods mapping to their publication labels
methods_labels <- c(
g_is   = "Gelfand IS",
g_tis  = "Gelfand TIS",
g_psis = "Gelfand PSIS",
b_is   = "Bronze IS",
b_tis  = "Bronze TIS",
b_psis = "Bronze PSIS",
z_is   = "Zanella IS",
z_tis  = "Zanella TIS",
z_psis = "Zanella PSIS"
)
# Start building the LaTeX tabular structure
latex_code <- c(
"\\begin{table}[ht]",
"\\centering",
"\\caption{Comparison of Sample Variance and Estimated Variance (on the Asymptotic Scale $S \\times \\text{Variance}$) of the $K$-fold ELPPD Estimator. All variance values are scaled by the MCMC sample size $S = 500,000$.}",
"\\label{tab:elppd_variance_comparison}",
"\\begin{tabular}{clcccc}",
"\\toprule",
"\\multirow{2.5}{*}{$K$} & \\multirow{2.5}{*}{Method} & Sample Variance & \\multicolumn{2}{c}{Estimated Variance ($S \\times \\widehat{\\text{Var}}_{\\text{est}}$)} & Ratio \\\\",
"\\cmidrule(lr){4-5}",
" & & ($S \\times \\text{Var}(\\widehat{\\text{ELPPD}})$) & Median & 95\\% CI & (Sample / Est) \\\\",
"\\midrule"
)
# Loop through each fold setting and method
for (K in K.vec) {
file_name <- paste0(K, "_fold_elppd_Gaussian.RData")
if (!file.exists(file_name)) {
stop(paste("File", file_name, "not found in current directory:", getwd()))
}
load(file_name) # Loads 'results' list
first_in_block <- TRUE
for (m in names(methods_labels)) {
var_col <- paste0("var_", m)
elppd_col <- paste0("elppd_", m)
# Scale both estimated and sample variances to the asymptotic scale (multiplied by S)
est_vars <- results[[var_col]] * S_mcmc
samp_var <- var(results[[elppd_col]]) * S_mcmc
median_est <- median(est_vars)
ci_est <- quantile(est_vars, probs = c(0.025, 0.975))
ratio <- samp_var / median_est
# Format the multirow label for K on the first row of each block
k_label <- if (first_in_block) paste0("\\multirow{9.5}{*}{", K, "}") else ""
first_in_block <- FALSE
# Clean numerical formatting for journal output
fmt <- function(x) {
if (is.na(x)) return("NA")
if (x > 1e4 || x < 1e-2) {
# Format using LaTeX scientific notation syntax: a \times 10^{b}
s <- formatC(x, format = "e", digits = 2)
parts <- strsplit(s, "e")[[1]]
exp_val <- as.numeric(parts[2])
paste0(parts[1], " \\times 10^{", exp_val, "}")
} else {
formatC(x, format = "f", digits = 2)
}
}
ci_str <- paste0("[", fmt(ci_est[1]), ", ", fmt(ci_est[2]), "]")
# Generate the LaTeX row
row_str <- paste(
k_label, "&",
methods_labels[m], "&",
fmt(samp_var), "&",
fmt(median_est), "&",
ci_str, "&",
formatC(ratio, format = "f", digits = 2),
"\\\\"
)
latex_code <- c(latex_code, row_str)
}
# Add midrule separator between groups (except the last group)
if (K != tail(K.vec, 1)) {
latex_code <- c(latex_code, "\\midrule")
}
}
# Close the LaTeX code
latex_code <- c(
latex_code,
"\\bottomrule",
"\\end{tabular}",
"\\end{table}"
)
# 1. Save table directly to file
writeLines(latex_code, "variance_comparison_table.tex")
message("Saved table to 'variance_comparison_table.tex'")
# 2. Output code directly to console for copy-pasting
cat("\n--- Generated LaTeX Table Code ---\n\n")
cat(paste(latex_code, collapse = "\n"), "\n")
# ==============================================================================
# Reproducible R Script to Generate Publication-Ready LaTeX Table for ELPPD Variance
# ==============================================================================
# Set working directory to the script's directory (if run from a file/RStudio)
if (requireNamespace("this.path", quietly = TRUE)) {
setwd(this.path::here())
}
# Configuration
K.vec <- c(5, 10, 50)
S_mcmc <- 5e5 # MCMC Sample size (iterations)
# Methods mapping to their publication labels
methods_labels <- c(
g_is   = "Gelfand IS",
g_tis  = "Gelfand TIS",
g_psis = "Gelfand PSIS",
b_is   = "Bronze IS",
b_tis  = "Bronze TIS",
b_psis = "Bronze PSIS",
z_is   = "Zanella IS",
z_tis  = "Zanella TIS",
z_psis = "Zanella PSIS"
)
# Start building the LaTeX tabular structure
latex_code <- c(
"\\begin{table}[ht]",
"\\centering",
"\\caption{Comparison of Sample Variance and Estimated Variance (on the Asymptotic Scale $S \\times \\text{Variance}$) of the $K$-fold ELPPD Estimator. All variance values are scaled by the MCMC sample size $S = 500,000$.}",
"\\label{tab:elppd_variance_comparison}",
"\\begin{tabular}{clcccc}",
"\\toprule",
"\\multirow{2.5}{*}{$K$} & \\multirow{2.5}{*}{Method} & Sample Variance & \\multicolumn{2}{c}{Estimated Variance ($S \\times \\widehat{\\text{Var}}_{\\text{est}}$)} & Ratio \\\\",
"\\cmidrule(lr){4-5}",
" & & ($S \\times \\text{Var}(\\widehat{\\text{ELPPD}})$) & Median & 95\\% CI & (Sample / Est) \\\\",
"\\midrule"
)
# Loop through each fold setting and method
for (K in K.vec) {
file_name <- paste0(K, "_fold_elppd_Gaussian.RData")
if (!file.exists(file_name)) {
stop(paste("File", file_name, "not found in current directory:", getwd()))
}
load(file_name) # Loads 'results' list
first_in_block <- TRUE
for (m in names(methods_labels)) {
var_col <- paste0("var_", m)
elppd_col <- paste0("elppd_", m)
# Scale both estimated and sample variances to the asymptotic scale (multiplied by S)
est_vars <- results[[var_col]] * S_mcmc
samp_var <- var(results[[elppd_col]]) * S_mcmc
median_est <- median(est_vars)
ci_est <- quantile(est_vars, probs = c(0.025, 0.975))
ratio <- samp_var / median_est
# Format the multirow label for K on the first row of each block
k_label <- if (first_in_block) paste0("\\multirow{9.5}{*}{", K, "}") else ""
first_in_block <- FALSE
# Clean numerical formatting for journal output and wrap in LaTeX math mode ($)
fmt <- function(x) {
if (is.na(x)) return("NA")
if (x > 1e4 || x < 1e-2) {
# Format using LaTeX scientific notation syntax: $a \times 10^{b}$
s <- formatC(x, format = "e", digits = 2)
parts <- strsplit(s, "e")[[1]]
exp_val <- as.numeric(parts[2])
paste0("$", parts[1], " \\times 10^{", exp_val, "}$")
} else {
paste0("$", formatC(x, format = "f", digits = 2), "$")
}
}
ci_str <- paste0("[", fmt(ci_est[1]), ", ", fmt(ci_est[2]), "]")
# Generate the LaTeX row
row_str <- paste(
k_label, "&",
methods_labels[m], "&",
fmt(samp_var), "&",
fmt(median_est), "&",
ci_str, "&",
formatC(ratio, format = "f", digits = 2),
"\\\\"
)
latex_code <- c(latex_code, row_str)
}
# Add midrule separator between groups (except the last group)
if (K != tail(K.vec, 1)) {
latex_code <- c(latex_code, "\\midrule")
}
}
# Close the LaTeX code
latex_code <- c(
latex_code,
"\\bottomrule",
"\\end{tabular}",
"\\end{table}"
)
# 1. Save table directly to file
writeLines(latex_code, "variance_comparison_table.tex")
message("Saved table to 'variance_comparison_table.tex'")
# 2. Output code directly to console for copy-pasting
cat("\n--- Generated LaTeX Table Code ---\n\n")
cat(paste(latex_code, collapse = "\n"), "\n")
